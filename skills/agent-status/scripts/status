#!/usr/bin/env python3
"""agent-status - live progress dashboard over relay (relay/SQLite) + Herdr.

Sources, best-effort and independent:
  relay   : read-only view of <repo>/.relay/state.db (tasks / workers)
  herdr   : `herdr pane list` for the relevant workspaces (live agent state)
  git     : HEAD / branch / dirty count (KPI)
  plan    : optional hand-written .agent-status/plan.json fallback

Subcommands: render (default), watch, show, hide, doctor.
No third-party dependencies; Python 3.8+ stdlib only.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

STATE_DIRNAME = ".agent-status"
WATCH_DEFAULT = 5

DEFAULT_CONFIG = {
    "title": None,
    "subtitle": None,
    "relay": {"enabled": True, "db": None},
    "plan": {"enabled": True, "path": f"{STATE_DIRNAME}/plan.json"},
    "herdr": {"enabled": True, "workspaces": [], "cwd_match": True, "show_shells": False},
    "kpi": {"exclude": ["README.md", "catalog.json", "notes/", "papers/", "summaries/", ".agent-status/"]},
    "extras": [],
    "watch_interval": WATCH_DEFAULT,
}

# ANSI palette
ANSI = {
    "reset": "\033[0m", "bold": "\033[1m", "dim": "\033[2m",
    "red": "\033[31m", "green": "\033[32m", "yellow": "\033[33m",
    "blue": "\033[34m", "magenta": "\033[35m", "cyan": "\033[36m", "gray": "\033[90m",
}

TASK_ORDER = ["running", "queued", "review", "blocked_human", "blocked_internal", "failed"]
TASK_COLOR = {
    "running": "green", "queued": "cyan", "review": "yellow",
    "blocked_human": "red", "blocked_internal": "magenta", "failed": "red", "done": "gray",
}
# plan 台帳（done/working/delegated/pending/blocked）用
PLAN_COLOR = {
    "done": "green", "working": "yellow", "delegated": "cyan",
    "pending": "gray", "blocked": "red", "failed": "red",
    "running": "green", "queued": "cyan", "review": "yellow",
}
WORKER_COLOR = {
    "working": "green", "idle": "gray", "waiting_input": "yellow",
    "stalled": "red", "dead": "red", "starting": "cyan",
}
AGENT_COLOR = {
    "working": "green", "idle": "gray", "blocked": "red",
    "done": "gray", "unknown": "yellow",
}


# --------------------------------------------------------------------------- #
# small utilities
# --------------------------------------------------------------------------- #
def run(cmd, cwd=None, timeout=20):
    """Run a command. A list is exec'd directly; a string goes through the shell."""
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=timeout, shell=isinstance(cmd, str))
    except Exception:
        return None
    if p.returncode != 0:
        return None
    return p.stdout.strip()


def deep_merge(base, override):
    out = dict(base)
    for k, v in (override or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def repo_root(explicit):
    if explicit:
        return str(Path(explicit).expanduser().resolve())
    top = run(["git", "rev-parse", "--show-toplevel"])
    if top:
        return str(Path(top).resolve())
    return str(Path.cwd().resolve())


def state_dir(root):
    p = Path(root) / STATE_DIRNAME
    try:
        p.mkdir(parents=True, exist_ok=True)
        return p
    except Exception:
        import tempfile
        alt = Path(tempfile.gettempdir()) / f"agent-status-{abs(hash(root)) & 0xFFFFFF:x}"
        alt.mkdir(parents=True, exist_ok=True)
        return alt


def load_config(root, explicit):
    path = explicit or os.environ.get("AGENT_STATUS_CONFIG")
    p = None
    if path:
        p = Path(os.path.expanduser(path))
        if not p.is_absolute():
            p = Path(root) / p
    else:
        cand = Path(root) / STATE_DIRNAME / "config.json"
        p = cand if cand.exists() else None
    data = {}
    if p and p.exists():
        try:
            data = json.loads(p.read_text())
        except Exception as exc:  # noqa: BLE001
            print(f"agent-status: ignoring bad config {p}: {exc}", file=sys.stderr)
    return deep_merge(DEFAULT_CONFIG, data), (str(p) if p else None)


def _tracked_pane(root):
    """The pane this skill is currently drawing in, if any (no side effects)."""
    try:
        p = Path(root) / STATE_DIRNAME / "status-pane"
        if p.exists():
            return p.read_text().strip() or None
    except Exception:
        pass
    return None


def _config_stamp(root, explicit):
    path = explicit or os.environ.get("AGENT_STATUS_CONFIG")
    if path:
        p = Path(os.path.expanduser(path))
        if not p.is_absolute():
            p = Path(root) / p
    else:
        p = Path(root) / STATE_DIRNAME / "config.json"
    try:
        return (str(p), p.stat().st_mtime_ns)
    except Exception:
        return (str(p), None)


def is_under(path, root):
    if not path:
        return False
    try:
        return os.path.commonpath([os.path.realpath(path), os.path.realpath(root)]) == os.path.realpath(root)
    except Exception:
        return False


def color(text, name, enabled):
    if not enabled or not name:
        return text
    return f"{ANSI.get(name, '')}{text}{ANSI['reset']}"


# --------------------------------------------------------------------------- #
# sources: relay
# --------------------------------------------------------------------------- #
def find_relay_db(root, cfg):
    cand = cfg["relay"].get("db") or os.environ.get("RELAY_DB")
    if cand:
        p = Path(os.path.expanduser(cand))
        if not p.is_absolute():
            p = Path(root) / p
        return str(p) if p.exists() else None
    cur = Path(root).resolve()
    for _ in range(12):
        p = cur / ".relay" / "state.db"
        if p.exists():
            return str(p)
        if cur.parent == cur:
            break
        cur = cur.parent
    return None


def _sqlite_rows(db, sql):
    """Read-only query. Try stdlib sqlite3, then the sqlite3 CLI as fallback."""
    try:
        uri = f"file:{db}?mode=ro"
        con = sqlite3.connect(uri, uri=True, timeout=3)
        con.row_factory = sqlite3.Row
        try:
            return [dict(r) for r in con.execute(sql).fetchall()]
        finally:
            con.close()
    except Exception:
        pass
    try:
        p = subprocess.run(["sqlite3", "-readonly", "-json", db, sql],
                           capture_output=True, text=True, timeout=10)
        if p.returncode == 0 and p.stdout.strip():
            return json.loads(p.stdout)
    except Exception:
        pass
    return None


def read_relay(db):
    if not db:
        return None
    tasks = _sqlite_rows(
        db, "SELECT id,title,state,priority,role,assignee,parent_task_id,updated_at FROM tasks")
    workers = _sqlite_rows(
        db, "SELECT id,role,state,current_task_id,generation,last_progress_at FROM workers")
    if tasks is None and workers is None:
        return None
    return {"db": db, "tasks": tasks or [], "workers": workers or []}


# --------------------------------------------------------------------------- #
# sources: plan fallback
# --------------------------------------------------------------------------- #
def read_plan(root, cfg):
    if not cfg["plan"].get("enabled", True):
        return None, None
    raw = cfg["plan"].get("path") or f"{STATE_DIRNAME}/plan.json"
    p = Path(os.path.expanduser(raw))
    if not p.is_absolute():
        p = Path(root) / p
    if not p.exists():
        return None, None
    try:
        data = json.loads(p.read_text())
    except Exception as exc:  # noqa: BLE001
        print(f"agent-status: ignoring bad plan {p}: {exc}", file=sys.stderr)
        return str(p), None
    if isinstance(data, list):
        data = {"tasks": data}
    data.setdefault("tasks", [])
    return str(p), data


# --------------------------------------------------------------------------- #
# sources: herdr
# --------------------------------------------------------------------------- #
def herdr_json(args):
    out = run(["herdr"] + args)
    if not out:
        return None
    try:
        return json.loads(out)
    except Exception:
        return None


def read_agents(cfg, root, extra_ws):
    if not cfg["herdr"].get("enabled", True) or os.environ.get("HERDR_ENV") != "1":
        return None
    ws = list(dict.fromkeys(list(extra_ws or []) + list(cfg["herdr"].get("workspaces") or [])))
    if not ws:
        cur = os.environ.get("HERDR_WORKSPACE_ID")
        if cur:
            ws = [cur]
    panes = []
    for w in ws:
        d = herdr_json(["pane", "list", "--workspace", w])
        if not d:
            continue
        for p in d.get("result", {}).get("panes", []):
            panes.append({
                "pane_id": p.get("pane_id", "?"),
                "agent": p.get("agent") or "-",
                "agent_status": p.get("agent_status") or "unknown",
                "title": p.get("terminal_title_stripped") or p.get("terminal_title") or "",
                "cwd": p.get("cwd") or "",
                "workspace_id": p.get("workspace_id") or w,
                "tab_id": p.get("tab_id") or "",
                "focused": bool(p.get("focused")),
            })
    if cfg["herdr"].get("cwd_match", True):
        panes = [p for p in panes if is_under(p["cwd"], root)]
    # Never list the dashboard's own pane.
    tracked = _tracked_pane(root)
    if tracked:
        panes = [p for p in panes if p["pane_id"] != tracked]
    # By default hide panes that are not running a recognized agent (shells,
    # one-off commands). Set herdr.show_shells=true to include them.
    if not cfg["herdr"].get("show_shells", False):
        panes = [p for p in panes if p["agent"] and p["agent"] != "-"]
    return panes


# --------------------------------------------------------------------------- #
# sources: git + extras
# --------------------------------------------------------------------------- #
def read_git(root, cfg):
    head = run(["git", "log", "-1", "--format=%h %s"], cwd=root) or "?"
    branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=root) or "?"
    raw = run(["git", "status", "--porcelain"], cwd=root) or ""
    exclude = cfg["kpi"].get("exclude") or []
    dirty = 0
    for line in raw.splitlines():
        path = line[3:] if len(line) > 3 else line
        if any(token in path for token in exclude):
            continue
        dirty += 1
    return {"head": head, "head_sha": head.split(" ")[0], "branch": branch, "dirty": dirty}


def run_extra(cmd, cwd):
    """Extras runner: never raises and always returns a display string.

    On failure returns `!(reason)` instead of a silent `?`. A list is exec'd
    directly; a string goes through the shell (pipes work).
    """
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=20, shell=isinstance(cmd, str))
    except subprocess.TimeoutExpired:
        return "!(timeout)"
    except FileNotFoundError as exc:
        return f"!(not found: {exc.filename or cmd})"
    except Exception as exc:  # noqa: BLE001
        return f"!({type(exc).__name__})"
    if p.returncode != 0:
        last = (p.stderr or "").strip().splitlines()
        return f"!(exit {p.returncode}{': ' + last[-1][:60] if last else ''})"
    return p.stdout.strip()


def read_extras(root, cfg):
    out = []
    for item in cfg.get("extras") or []:
        if not isinstance(item, dict) or not item.get("command"):
            continue
        raw = item["command"]
        label = item.get("label") or (raw if isinstance(raw, str) else " ".join(raw))
        out.append({"label": label, "value": run_extra(raw, root)})
    return out


# --------------------------------------------------------------------------- #
# collect
# --------------------------------------------------------------------------- #
def _tree_order(items, key=None):
    """Order a flat task list as a forest by `parent` (parent task id).

    Returns `[(item, depth), ...]`. Items are dicts with `id` and optional
    `parent`. Orphans and cycles fall back to depth 0 so nothing is ever dropped.
    `key` sorts siblings; `None` keeps input order.
    """
    by_id = {str(it["id"]): it for it in items if it.get("id") is not None}
    children, roots = {}, []
    for it in items:
        pid = it.get("parent")
        parent = str(pid) if pid not in (None, "", "null") else None
        own = str(it.get("id")) if it.get("id") is not None else None
        if parent and parent in by_id and parent != own:
            children.setdefault(parent, []).append(it)
        else:
            roots.append(it)
    if key:
        roots.sort(key=key)
        for group in children.values():
            group.sort(key=key)

    out, seen = [], set()

    def walk(node, depth):
        nid = str(node.get("id")) if node.get("id") is not None else None
        if nid is not None:
            if nid in seen:
                return
            seen.add(nid)
        out.append((node, depth))
        if nid is not None:
            for child in children.get(nid, []):
                walk(child, depth + 1)

    for root in roots:
        walk(root, 0)
    for it in items:  # cycles / unreachable
        nid = str(it.get("id")) if it.get("id") is not None else None
        if nid is not None and nid not in seen:
            seen.add(nid)
            out.append((it, 0))
    return out


def collect(root, cfg, workspaces):
    relay = read_relay(find_relay_db(root, cfg))
    plan_path, plan = read_plan(root, cfg)
    agents = read_agents(cfg, root, workspaces)

    tasks = {"counts": {}, "total": 0, "done": 0, "remaining": [], "done_list": []}
    if relay:
        for t in relay["tasks"]:
            st = t.get("state") or "queued"
            tasks["counts"][st] = tasks["counts"].get(st, 0) + 1
        tasks["total"] = len(relay["tasks"])
        tasks["done"] = tasks["counts"].get("done", 0)
        order = {s: i for i, s in enumerate(TASK_ORDER)}
        items = [{
            "id": t.get("id"), "state": t.get("state") or "queued",
            "title": t.get("title") or "", "priority": t.get("priority"),
            "role": t.get("role"), "assignee": t.get("assignee"),
            "parent": t.get("parent_task_id"), "updated_at": t.get("updated_at"),
        } for t in relay["tasks"]]
        ranked = _tree_order(
            items, key=lambda x: (order.get(x["state"], 99), -(x["priority"] or 0)))
        for item, depth in ranked:
            item["depth"] = depth
            (tasks["done_list"] if item["state"] == "done" else tasks["remaining"]).append(item)

    workers = []
    if relay:
        now_ms = time.time() * 1000
        for w in relay["workers"]:
            lp = w.get("last_progress_at") or 0
            workers.append({
                "id": w.get("id"), "role": w.get("role"), "state": w.get("state"),
                "task": w.get("current_task_id"), "generation": w.get("generation"),
                "idle_ms": int(now_ms - lp) if lp else None,
            })
        workers.sort(key=lambda x: x["id"] or "")

    plan_tasks = []
    if plan:
        plan_tasks = [dict(it) for it in (plan.get("tasks") or [])]
        for it, depth in _tree_order(plan_tasks):
            it["depth"] = depth

    title = cfg.get("title") or Path(root).name
    return {
        "root": root,
        "title": title,
        "subtitle": cfg.get("subtitle"),
        "sources": {
            "relay": (relay or {}).get("db"),
            "plan": plan_path if plan else None,
            "herdr": agents is not None,
        },
        "kpi": read_git(root, cfg),
        "extras": read_extras(root, cfg),
        "tasks": tasks,
        "workers": workers,
        "plan": plan_tasks,
        "plan_title": (plan or {}).get("title") if plan else None,
        "agents": agents or [],
    }


# --------------------------------------------------------------------------- #
# render
# --------------------------------------------------------------------------- #
def fmt_age(ms):
    if ms is None:
        return "-"
    s = max(0, int(ms / 1000))
    if s < 60:
        return f"{s}s"
    m = s // 60
    if m < 60:
        return f"{m}m"
    return f"{m // 60}h"


def progress_bar(done, total, width=22):
    if total <= 0:
        return "[" + "-" * width + "]"
    filled = int(round(width * done / total))
    return "[" + "#" * filled + "-" * (width - filled) + "]"


def render_text(data, use_color):
    c = lambda t, name: color(t, name, use_color)  # noqa: E731
    lines = []
    lines.append(c(data["title"], "bold"))
    if data.get("subtitle"):
        lines.append(c(data["subtitle"], "gray"))
    k = data["kpi"]
    lines.append(f"HEAD {k['head_sha']}  branch {k['branch']}  dirty {k['dirty']}")
    extra_parts = []
    for e in data.get("extras", []):
        v = str(e["value"])
        extra_parts.append(f"{e['label']} " + (color(v, "red", use_color) if v.startswith("!(") else v))
    extra = "  ".join(extra_parts)
    if extra:
        lines.append(extra)

    t = data["tasks"]
    if t["total"] or data.get("sources", {}).get("relay"):
        counts = t["counts"]
        workers = data["workers"]
        working = sum(1 for w in workers if w["state"] == "working")
        bar = progress_bar(t["done"], t["total"])
        lines.append("")
        lines.append(
            f"tasks {c(str(t['done']), 'green')}/{t['total']} {bar}   "
            f"workers {c(str(working), 'green')} working / {len(workers)}   "
            + " ".join(f"{s}={counts.get(s, 0)}" for s in
                       ["running", "queued", "review", "blocked_human", "blocked_internal", "failed"])
        )

        lines.append("")
        lines.append(c("REMAINING", "bold"))
        if not t["remaining"]:
            lines.append(c("  (none)", "gray"))
        for it in t["remaining"]:
            st = it["state"]
            tag = color(f"{st:<16}", TASK_COLOR.get(st), use_color)
            owner = it.get("assignee") or it.get("role") or "-"
            indent = "  " * (it.get("depth") or 0)
            lines.append(f"  {indent}{tag} {it.get('id') or '?':<8} {it['title'][:64]}  [{owner}]")

        lines.append("")
        lines.append(c(f"DONE ({t['done']})", "bold"))
        if not t["done_list"]:
            lines.append(c("  (none)", "gray"))
        for it in t["done_list"][:30]:
            indent = "  " * (it.get("depth") or 0)
            lines.append(c(f"  {indent}{str(it.get('id') or '?'):<8} {it['title'][:64]}", "gray"))
        if len(t["done_list"]) > 30:
            lines.append(c(f"  ... +{len(t['done_list']) - 30} more", "gray"))

    if data["workers"]:
        lines.append("")
        lines.append(c("RELAY WORKERS", "bold"))
        for w in data["workers"]:
            tag = color(f"{w['state']:<14}", WORKER_COLOR.get(w["state"]), use_color)
            lines.append(f"  {tag} {str(w['id']):<14} task={w.get('task') or '-'}  "
                         f"gen={w.get('generation')}  last-progress {fmt_age(w.get('idle_ms'))}")

    if data["plan"]:
        lines.append("")
        lines.append(c("PLAN (" + (data.get("plan_title") or "manual") + ")", "bold"))
        for it in data["plan"]:
            st = (it.get("status") or "pending")
            tag = color(f"{st:<10}", PLAN_COLOR.get(st, "gray"), use_color)
            indent = "  " * (it.get("depth") or 0)
            lines.append(f"  {indent}{tag} {it.get('title') or '?'}  [{it.get('owner') or '-'}]"
                         + (f"  - {it['note']}" if it.get("note") else ""))

    if data["sources"].get("herdr") is not None and data["agents"]:
        lines.append("")
        lines.append(c("HERDR PANES", "bold"))
        for a in data["agents"]:
            tag = color(f"{a['agent_status']:<8}", AGENT_COLOR.get(a["agent_status"]), use_color)
            star = "*" if a.get("focused") else " "
            lines.append(f" {star}{a['pane_id']:<9} {tag} {a['title'][:56]}")

    lines.append("")
    src = []
    src.append("relay:" + (Path(data["sources"]["relay"]).parent.parent.name
                           if data["sources"].get("relay") else "none"))
    src.append("herdr:" + ("on" if data["sources"].get("herdr") else "off"))
    src.append("plan:" + ("yes" if data["sources"].get("plan") else "no"))
    lines.append(c("sources " + "  ".join(src), "gray"))
    return "\n".join(lines)


def render_json(data):
    return json.dumps(data, ensure_ascii=False, indent=2)


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #
def cmd_render(args, root, cfg):
    data = collect(root, cfg, args.workspaces)
    if args.json:
        print(render_json(data))
    else:
        print(render_text(data, sys.stdout.isatty() or os.environ.get("FORCE_COLOR") == "1"))


def cmd_watch(args, root, cfg):
    explicit = getattr(args, "config", None)
    stamp = _config_stamp(root, explicit)
    try:
        while True:
            cur = _config_stamp(root, explicit)
            if cur != stamp:  # config.json edited/appeared/removed -> reload
                cfg, _ = load_config(root, explicit)
                stamp = cur
            interval = args.interval or cfg.get("watch_interval") or WATCH_DEFAULT
            data = collect(root, cfg, args.workspaces)
            sys.stdout.write("\033[2J\033[H")
            print(render_text(data, True))
            sys.stdout.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        pass


def _status_pane_file(root):
    return state_dir(root) / "status-pane"


def _pane_alive(pane):
    return herdr_json(["pane", "get", pane]) is not None


def cmd_show(args, root, cfg):
    if os.environ.get("HERDR_ENV") != "1":
        print("agent-status: not inside Herdr (HERDR_ENV != 1); run `status render` instead", file=sys.stderr)
        return 2
    target = args.pane or os.environ.get("HERDR_PANE_ID")
    sf = _status_pane_file(root)
    pane = None
    if sf.exists():
        old = sf.read_text().strip()
        if old and _pane_alive(old):
            pane = old
    if pane is None:
        d = herdr_json(["pane", "split", "--pane", target, "--direction", args.direction,
                        "--cwd", root, "--no-focus"]) if target else \
            herdr_json(["pane", "split", "--current", "--direction", args.direction,
                        "--cwd", root, "--no-focus"])
        try:
            pane = d["result"]["pane"]["pane_id"]
        except Exception:
            print("agent-status: pane split failed", file=sys.stderr)
            return 2
        sf.write_text(pane)
    script = str(Path(__file__).resolve())
    interval = args.interval or cfg.get("watch_interval") or WATCH_DEFAULT
    cmdline = f"python3 {shlex.quote(script)} watch --repo {shlex.quote(root)} --interval {interval}"
    if args.config:
        cmdline += f" --config {shlex.quote(args.config)}"
    run(["herdr", "pane", "run", pane, cmdline])
    print(f"agent-status: live dashboard in {pane} (direction={args.direction})")
    print(f"  stop with: python3 {shlex.quote(script)} hide --repo {shlex.quote(root)}")
    return 0


def cmd_hide(args, root):
    sf = _status_pane_file(root)
    if not sf.exists():
        print("agent-status: no tracked status pane")
        return 0
    pane = sf.read_text().strip()
    sf.unlink(missing_ok=True)
    if pane:
        if _pane_alive(pane):
            run(["herdr", "pane", "close", pane])
            print(f"agent-status: closed {pane}")
        else:
            print(f"agent-status: {pane} already gone")
    return 0


def cmd_doctor(args, root, cfg, cfg_path):
    db = find_relay_db(root, cfg)
    plan_path, plan = read_plan(root, cfg)
    relay = read_relay(db) if db else None
    lines = [
        f"repo            {root}",
        f"config          {cfg_path or '(defaults)'}",
        f"HERDR_ENV       {os.environ.get('HERDR_ENV', '(unset)')}",
        f"HERDR_WORKSPACE {os.environ.get('HERDR_WORKSPACE_ID', '(unset)')}",
        f"relay db        {db or '(not found)'}",
    ]
    if relay:
        lines.append(f"  tasks         {len(relay['tasks'])} rows")
        lines.append(f"  workers       {len(relay['workers'])} rows")
    lines.append(f"plan            {plan_path or '(not found)'}"
                 + (f"  tasks={len(plan.get('tasks', []))}" if plan else ""))
    agents = read_agents(cfg, root, args.workspaces)
    lines.append(f"herdr panes     {len(agents) if agents is not None else 'off'}")
    print("\n".join(lines))
    return 0


# --------------------------------------------------------------------------- #
# entrypoint
# --------------------------------------------------------------------------- #
def build_parser():
    ap = argparse.ArgumentParser(prog="status", description="live progress dashboard (relay + Herdr)")
    sub = ap.add_subparsers(dest="cmd")

    def common(p):
        p.add_argument("--repo", default=None, help="repo root (default: git toplevel or cwd)")
        p.add_argument("--config", default=None, help="config json path")
        p.add_argument("--workspace", action="append", default=[], dest="workspaces",
                       help="Herdr workspace id (repeatable)")

    p = sub.add_parser("render", help="print one snapshot (default)")
    common(p)
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("watch", help="clear + redraw in a loop")
    common(p)
    p.add_argument("--interval", type=float, default=None)

    p = sub.add_parser("show", help="open a live dashboard pane next to a Herdr pane")
    common(p)
    p.add_argument("--direction", choices=["right", "down"], default="right")
    p.add_argument("--pane", default=None)
    p.add_argument("--interval", type=float, default=None)

    p = sub.add_parser("hide", help="close the tracked dashboard pane")
    p.add_argument("--repo", default=None)

    p = sub.add_parser("doctor", help="show which sources were detected")
    common(p)
    return ap


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0].startswith("-"):
        argv = ["render"] + argv
    args = build_parser().parse_args(argv)
    root = repo_root(getattr(args, "repo", None) or os.environ.get("AGENT_STATUS_REPO"))
    cfg, cfg_path = load_config(root, getattr(args, "config", None))

    if args.cmd == "render":
        cmd_render(args, root, cfg)
    elif args.cmd == "watch":
        cmd_watch(args, root, cfg)
    elif args.cmd == "show":
        return cmd_show(args, root, cfg)
    elif args.cmd == "hide":
        return cmd_hide(args, root)
    elif args.cmd == "doctor":
        return cmd_doctor(args, root, cfg, cfg_path)
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
