#!/usr/bin/env python3
"""agent-status - a read-only dashboard for a Relay control plane.

Sources:
  relay : READ-ONLY view of <repo>/.relay/state.db (tasks / workers / runtimes /
          messages). REQUIRED - this is the source of truth.
  herdr : live execution telemetry (`herdr pane list`): busy/idle per pane.
  git   : HEAD / branch / dirty count (light KPI only).

agent-status never mutates Relay state: no task/worker/message writes, no relay
commands. It is an observer.

    Relay is the source of truth.
    Workers are peers. Tasks may form a tree.
    Herdr is execution telemetry, not work state.

Subcommands: render (default), watch, show, hide, doctor.
No third-party dependencies; Python 3.8+ stdlib only.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import sqlite3
import subprocess
import sys
import time
import unicodedata
from pathlib import Path

STATE_DIRNAME = ".agent-status"
WATCH_DEFAULT = 5

DEFAULT_CONFIG = {
    "title": None,
    "subtitle": None,
    # Relay is required; only the DB location is configurable.
    "relay": {"db": None},
    "herdr": {
        "enabled": True,
        "workspaces": [],
        "cwd_match": True,
        "links": True,
        # Debug only: also show Herdr/OpenCode panes Relay does not manage.
        "show_unmanaged": False,
    },
    "kpi": {"exclude": ["README.md", "catalog.json", "notes/", "papers/", "summaries/", ".agent-status/"]},
    "extras": [],
    "watch_interval": WATCH_DEFAULT,
}

# ANSI palette
ANSI = {
    "reset": "\033[0m", "bold": "\033[1m", "dim": "\033[2m", "underline": "\033[4m",
    "red": "\033[31m", "green": "\033[32m", "yellow": "\033[33m",
    "blue": "\033[34m", "magenta": "\033[35m", "cyan": "\033[36m", "gray": "\033[90m",
}

# Relay task states, most-attention-worthy first (render order for counts).
TASK_ORDER = ["running", "queued", "review", "blocked_human", "blocked_internal", "failed"]
TASK_COLOR = {
    "running": "green", "queued": "cyan", "review": "yellow",
    "blocked_human": "red", "blocked_internal": "magenta", "failed": "red", "done": "gray",
}
WORKER_COLOR = {
    "working": "green", "idle": "gray", "waiting_input": "yellow",
    "stalled": "red", "dead": "red", "starting": "cyan",
}
# Herdr/OpenCode execution labels (runtime telemetry, NOT work state).
EXEC_COLOR = {"busy": "green", "idle": "gray", "!idle": "red", "unavailable": "gray"}


# --------------------------------------------------------------------------- #
# small utilities
# --------------------------------------------------------------------------- #
def run(cmd, cwd=None, timeout=20):
    """Run a command. A list is exec'd directly; a string goes through the shell."""
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=timeout, shell=isinstance(cmd, str))
    except Exception:
        return None
    if p.returncode != 0:
        return None
    return p.stdout.strip()


def deep_merge(base, override):
    out = dict(base)
    for k, v in (override or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def repo_root(explicit):
    if explicit:
        return str(Path(explicit).expanduser().resolve())
    top = run(["git", "rev-parse", "--show-toplevel"])
    if top:
        return str(Path(top).resolve())
    return str(Path.cwd().resolve())


def state_dir(root):
    p = Path(root) / STATE_DIRNAME
    try:
        p.mkdir(parents=True, exist_ok=True)
        return p
    except Exception:
        import tempfile
        alt = Path(tempfile.gettempdir()) / f"agent-status-{abs(hash(root)) & 0xFFFFFF:x}"
        alt.mkdir(parents=True, exist_ok=True)
        return alt


def load_config(root, explicit):
    path = explicit or os.environ.get("AGENT_STATUS_CONFIG")
    p = None
    if path:
        p = Path(os.path.expanduser(path))
        if not p.is_absolute():
            p = Path(root) / p
    else:
        cand = Path(root) / STATE_DIRNAME / "config.json"
        p = cand if cand.exists() else None
    data = {}
    if p and p.exists():
        try:
            data = json.loads(p.read_text())
        except Exception as exc:  # noqa: BLE001
            print(f"agent-status: ignoring bad config {p}: {exc}", file=sys.stderr)
    return deep_merge(DEFAULT_CONFIG, data), (str(p) if p else None)


def _tracked_pane(root):
    """The pane this skill is currently drawing in, if any (no side effects)."""
    try:
        p = Path(root) / STATE_DIRNAME / "status-pane"
        if p.exists():
            return p.read_text().strip() or None
    except Exception:
        pass
    return None


def _config_stamp(root, explicit):
    path = explicit or os.environ.get("AGENT_STATUS_CONFIG")
    if path:
        p = Path(os.path.expanduser(path))
        if not p.is_absolute():
            p = Path(root) / p
    else:
        p = Path(root) / STATE_DIRNAME / "config.json"
    try:
        return (str(p), p.stat().st_mtime_ns)
    except Exception:
        return (str(p), None)


def is_under(path, root):
    if not path:
        return False
    try:
        return os.path.commonpath([os.path.realpath(path), os.path.realpath(root)]) == os.path.realpath(root)
    except Exception:
        return False


def color(text, name, enabled):
    if not enabled or not name:
        return text
    return f"{ANSI.get(name, '')}{text}{ANSI['reset']}"


OSC8_PREFIX = "\033]8;;"
OSC8_SUFFIX = "\033\\"
# Ctrl+click target for a pane. An https URL is recognized as a link by every
# terminal; Herdr's [[link_handlers]] then routes the modified click to the
# agent-status plugin instead of opening it. The host never resolves.
PANE_LINK_BASE = "https://agent-status.local/pane/"


def link(text, url, enabled):
    """Wrap text in an OSC8 hyperlink (ST-terminated). Inert when disabled."""
    if not enabled or not url:
        return text
    return f"{OSC8_PREFIX}{url}{OSC8_SUFFIX}{text}{OSC8_PREFIX}{OSC8_SUFFIX}"


# --------------------------------------------------------------------------- #
# relay (REQUIRED, read-only)
# --------------------------------------------------------------------------- #
class RelayNotFound(Exception):
    def __init__(self, root):
        self.root = root
        super().__init__(root)

    def message(self):
        return (
            "agent-status: Relay control plane not found\n"
            f"expected: {Path(self.root) / '.relay' / 'state.db'}\n"
            "run: relay init"
        )


def find_relay_db(root, cfg):
    cand = cfg["relay"].get("db") or os.environ.get("RELAY_DB")
    if cand:
        p = Path(os.path.expanduser(cand))
        if not p.is_absolute():
            p = Path(root) / p
        return str(p) if p.exists() else None
    cur = Path(root).resolve()
    for _ in range(12):
        p = cur / ".relay" / "state.db"
        if p.exists():
            return str(p)
        if cur.parent == cur:
            break
        cur = cur.parent
    return None


def relay_db_or_fail(root, cfg):
    db = find_relay_db(root, cfg)
    if not db:
        raise RelayNotFound(root)
    return db


def _sqlite_rows(db, sql):
    """Read-only query. Try stdlib sqlite3, then the sqlite3 CLI as fallback."""
    try:
        uri = f"file:{db}?mode=ro"
        con = sqlite3.connect(uri, uri=True, timeout=3)
        con.row_factory = sqlite3.Row
        try:
            return [dict(r) for r in con.execute(sql).fetchall()]
        finally:
            con.close()
    except Exception:
        pass
    try:
        p = subprocess.run(["sqlite3", "-readonly", "-json", db, sql],
                           capture_output=True, text=True, timeout=10)
        if p.returncode == 0 and p.stdout.strip():
            return json.loads(p.stdout)
    except Exception:
        pass
    return None


def _has_column(db, table, column):
    """True when `table` exposes `column` (older relay DBs predate some of them)."""
    rows = _sqlite_rows(db, f"PRAGMA table_info({table})")
    return bool(rows) and any(r.get("name") == column for r in rows)


def read_relay(db):
    if not db:
        return None
    tasks = _sqlite_rows(
        db, "SELECT id,title,state,priority,role,assignee,parent_task_id,updated_at FROM tasks")
    # Retired workers are history only (relay `worker retire`); hide them.
    quiet_cols = ",quiet_until,quiet_reason" if _has_column(db, "workers", "quiet_until") else ""
    workers_sql = (
        "SELECT id,role,state,current_task_id,generation,last_progress_at" + quiet_cols + " FROM workers")
    if _has_column(db, "workers", "retired_at"):
        workers_sql += " WHERE retired_at IS NULL"
    workers = _sqlite_rows(db, workers_sql)
    runtimes = _sqlite_rows(
        db, "SELECT worker_id,generation,state,relay_owned,workspace_id,tab_id,pane_id,"
            "runtime_id,session_id,created_at FROM worker_runtimes")
    unread = _sqlite_rows(
        db, "SELECT recipient, COUNT(*) AS n FROM messages WHERE state IN ('queued','delivered') GROUP BY recipient")
    # Latest block reason per task (display only; no mutation).
    blocked = _sqlite_rows(
        db, "SELECT task_id, body FROM task_notes WHERE kind IN ('blocked_human','blocked_internal') ORDER BY id")
    if tasks is None and workers is None:
        return None
    return {
        "db": db,
        "tasks": tasks or [],
        "workers": workers or [],
        "runtimes": runtimes or [],
        "unread": {r["recipient"]: r["n"] for r in (unread or []) if r.get("recipient")},
        "blocked": {r["task_id"]: r["body"] for r in (blocked or []) if r.get("task_id")},
    }


# --------------------------------------------------------------------------- #
# herdr (execution telemetry)
# --------------------------------------------------------------------------- #
def herdr_json(args):
    out = run(["herdr"] + args)
    if not out:
        return None
    try:
        return json.loads(out)
    except Exception:
        return None


def relay_worker_workspaces(root, cfg):
    """Workspaces relay has actually placed a worker in (union with config)."""
    db = find_relay_db(root, cfg)
    if not db:
        return []
    rows = _sqlite_rows(db, "SELECT DISTINCT workspace_id FROM worker_runtimes WHERE workspace_id IS NOT NULL")
    if not rows:
        return []
    return [r.get("workspace_id") for r in rows if r.get("workspace_id")]


def read_agents(cfg, root, extra_ws):
    """Live Herdr panes as execution telemetry. None when Herdr is unavailable."""
    if not cfg["herdr"].get("enabled", True) or os.environ.get("HERDR_ENV") != "1":
        return None
    if extra_ws:
        ws = list(dict.fromkeys(extra_ws))
    else:
        ws = list(dict.fromkeys(
            list(cfg["herdr"].get("workspaces") or []) + relay_worker_workspaces(root, cfg)))
        if not ws:
            cur = os.environ.get("HERDR_WORKSPACE_ID")
            if cur:
                ws = [cur]
    panes = []
    for w in ws:
        d = herdr_json(["pane", "list", "--workspace", w])
        if not d:
            continue
        for p in d.get("result", {}).get("panes", []):
            panes.append({
                "pane_id": p.get("pane_id", "?"),
                "agent": p.get("agent") or "-",
                "agent_status": p.get("agent_status") or "unknown",
                "title": p.get("terminal_title_stripped") or p.get("terminal_title") or "",
                "cwd": p.get("cwd") or "",
                "workspace_id": p.get("workspace_id") or w,
                "tab_id": p.get("tab_id") or "",
                "focused": bool(p.get("focused")),
            })
    if cfg["herdr"].get("cwd_match", True):
        panes = [p for p in panes if is_under(p["cwd"], root)]
    tracked = _tracked_pane(root)
    if tracked:
        panes = [p for p in panes if p["pane_id"] != tracked]
    if not cfg["herdr"].get("show_unmanaged", False):
        panes = [p for p in panes if p["agent"] and p["agent"] != "-"]
    return panes


# --------------------------------------------------------------------------- #
# git + extras
# --------------------------------------------------------------------------- #
def read_git(root, cfg):
    head = run(["git", "log", "-1", "--format=%h %s"], cwd=root) or "?"
    branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=root) or "?"
    raw = run(["git", "status", "--porcelain"], cwd=root) or ""
    exclude = cfg["kpi"].get("exclude") or []
    dirty = 0
    for line in raw.splitlines():
        path = line[3:] if len(line) > 3 else line
        if any(token in path for token in exclude):
            continue
        dirty += 1
    return {"head": head, "head_sha": head.split(" ")[0], "branch": branch, "dirty": dirty}


def run_extra(cmd, cwd):
    """Extras runner: never raises and always returns a display string."""
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=20, shell=isinstance(cmd, str))
    except subprocess.TimeoutExpired:
        return "!(timeout)"
    except FileNotFoundError as exc:
        return f"!(not found: {exc.filename or cmd})"
    except Exception as exc:  # noqa: BLE001
        return f"!({type(exc).__name__})"
    if p.returncode != 0:
        last = (p.stderr or "").strip().splitlines()
        return f"!(exit {p.returncode}{': ' + last[-1][:60] if last else ''})"
    return p.stdout.strip()


def read_extras(root, cfg):
    out = []
    for item in cfg.get("extras") or []:
        if not isinstance(item, dict) or not item.get("command"):
            continue
        raw = item["command"]
        label = item.get("label") or (raw if isinstance(raw, str) else " ".join(raw))
        out.append({"label": label, "value": run_extra(raw, root)})
    return out


# --------------------------------------------------------------------------- #
# collect
# --------------------------------------------------------------------------- #
def _tree_order(items, key=None):
    """Order a flat task list as a forest by `parent_task_id`.

    Returns `[(item, depth), ...]`. Orphans and cycles fall back to depth 0 so
    nothing is ever dropped. `key` sorts siblings.
    """
    by_id = {str(it["id"]): it for it in items if it.get("id") is not None}
    children, roots = {}, []
    for it in items:
        pid = it.get("parent")
        parent = str(pid) if pid not in (None, "", "null") else None
        own = str(it.get("id")) if it.get("id") is not None else None
        if parent and parent in by_id and parent != own:
            children.setdefault(parent, []).append(it)
        else:
            roots.append(it)
    if key:
        roots.sort(key=key)
        for group in children.values():
            group.sort(key=key)

    out, seen = [], set()

    def walk(node, depth):
        nid = str(node.get("id")) if node.get("id") is not None else None
        if nid is not None:
            if nid in seen:
                return
            seen.add(nid)
        out.append((node, depth))
        if nid is not None:
            for child in children.get(nid, []):
                walk(child, depth + 1)

    for root in roots:
        walk(root, 0)
    for it in items:  # cycles / unreachable
        nid = str(it.get("id")) if it.get("id") is not None else None
        if nid is not None and nid not in seen:
            seen.add(nid)
            out.append((it, 0))
    return out


def _task_sort_key(state_order):
    def key(x):
        return (state_order.get(x["state"], 99), -(x["priority"] or 0),
                str(x.get("id") or ""))
    return key


UNFINISHED = ("running", "queued", "review", "blocked_human", "blocked_internal", "failed")


def collect(root, cfg, workspaces):
    db = relay_db_or_fail(root, cfg)  # Relay is mandatory: raises otherwise
    relay = read_relay(db)
    if relay is None:
        raise RelayNotFound(root)
    agents = read_agents(cfg, root, workspaces)
    pane_by_id = {p["pane_id"]: p for p in (agents or [])}
    now_ms = time.time() * 1000

    # ---- tasks: one flat list, ordered as a tree -----------------------------
    state_order = {s: i for i, s in enumerate(TASK_ORDER)}
    state_order["done"] = len(TASK_ORDER)  # done sorts after active siblings
    items = []
    for t in relay["tasks"]:
        items.append({
            "id": t.get("id"),
            "title": t.get("title") or "",
            "state": t.get("state") or "queued",
            "priority": t.get("priority"),
            "role": t.get("role"),
            "assignee": t.get("assignee"),
            "parent": t.get("parent_task_id"),
            "updated_at": t.get("updated_at"),
        })
    ranked = _tree_order(items, key=_task_sort_key(state_order))
    tree = []
    counts = {}
    done = 0
    for item, depth in ranked:
        item["depth"] = depth
        if item["state"] == "done":
            done += 1
        counts[item["state"]] = counts.get(item["state"], 0) + 1
        tree.append(item)

    task_by_id = {str(it["id"]): it for it in tree if it.get("id") is not None}

    # ---- workers: Relay row is primary, Herdr is an overlay ------------------
    latest = {}
    for r in relay.get("runtimes") or []:
        wid = r.get("worker_id")
        if not wid:
            continue
        k = (r.get("generation") or 0, r.get("created_at") or 0)
        if wid not in latest or k > latest[wid][0]:
            latest[wid] = (k, r)

    workers = []
    for w in relay["workers"]:
        wid = w.get("id")
        rt = latest.get(wid, (None, {}))[1]
        pane = pane_by_id.get(rt.get("pane_id")) if rt.get("pane_id") else None
        quiet_until = w.get("quiet_until")
        quiet_active = bool(
            quiet_until and quiet_until > now_ms and w.get("current_task_id")
            and quiet_until is not None)
        # relay quiet_task_id is not exposed here; the task pointer is the scope.
        exec_label = _exec_label(cfg, w, pane, quiet_until, quiet_active, now_ms)
        lp = w.get("last_progress_at") or 0
        workers.append({
            "id": wid,
            "role": w.get("role"),
            "state": w.get("state"),
            "task": w.get("current_task_id"),
            "generation": w.get("generation"),
            "progress_ms": int(now_ms - lp) if lp else None,
            "quiet_until": quiet_until,
            "quiet_reason": w.get("quiet_reason"),
            "quiet_active": quiet_active,
            "exec": exec_label,
            "pane": rt.get("pane_id"),
            "runtime_id": rt.get("runtime_id"),
            "workspace": rt.get("workspace_id"),
            "tab": rt.get("tab_id"),
            "runtime_state": rt.get("state"),
            "agent_status": (pane or {}).get("agent_status"),
            "unread": relay.get("unread", {}).get(wid, 0),
        })
    workers.sort(key=lambda x: (x.get("id") or ""))

    # ---- attention (derived only) --------------------------------------------
    roles = {w.get("role") for w in relay["workers"]}
    attention = []
    for w in workers:
        if w["state"] in ("dead", "stalled"):
            attention.append({"kind": "worker", "id": w["id"],
                              "text": f"{w['state']} generation={w['generation']}"})
        if w["state"] == "working" and w["exec"] == "!idle":
            age = fmt_age(w.get("progress_ms"))
            attention.append({"kind": "worker", "id": w["id"], "age": age,
                              "text": f"{w['task'] or '-'} working but runtime idle, no quiet lease"})
        if w["state"] == "starting" and (w.get("progress_ms") or 0) > 120_000:
            attention.append({"kind": "worker", "id": w["id"],
                              "text": f"starting for {fmt_age(w['progress_ms'])} (attach stuck?)"})
        if w["unread"]:
            attention.append({"kind": "worker", "id": w["id"], "text": f"unread messages={w['unread']}"})
        if not w.get("pane"):
            attention.append({"kind": "worker", "id": w["id"],
                              "text": "supervised worker has no visible runtime pane"})
    for it in tree:
        if it["state"] in ("queued",) and it.get("role") and it["role"] not in roles:
            attention.append({"kind": "task", "id": it["id"], "text": f"unclaimable role={it['role']}"})
        elif it["state"] in ("blocked_human", "blocked_internal"):
            reason = relay.get("blocked", {}).get(it["id"]) or ""
            suffix = f": {reason}" if reason else ""
            attention.append({"kind": "task", "id": it["id"],
                              "text": f"{it['state']}{suffix}"})
        elif it["state"] == "failed":
            attention.append({"kind": "task", "id": it["id"], "text": "failed"})

    # ---- runtimes (worker-centric) -------------------------------------------
    runtimes = [{
        "worker": w["id"], "generation": w["generation"], "pane": w.get("pane"),
        "runtime_id": w.get("runtime_id"), "workspace": w.get("workspace"), "tab": w.get("tab"),
        "state": w.get("runtime_state"), "agent": "opencode" if w.get("pane") else None,
        "agent_status": w.get("agent_status"),
    } for w in workers]
    if cfg["herdr"].get("show_unmanaged", False) and agents:
        mapped = {r["pane"] for r in runtimes if r.get("pane")}
        for p in agents:
            if p["pane_id"] in mapped:
                continue
            runtimes.append({
                "worker": "-", "generation": None, "pane": p["pane_id"], "runtime_id": None,
                "workspace": p.get("workspace_id"), "tab": p.get("tab_id"),
                "state": None, "agent": p.get("agent"), "agent_status": p.get("agent_status"),
                "unmanaged": True,
            })

    title = cfg.get("title") or Path(root).name
    return {
        "root": root,
        "title": title,
        "subtitle": cfg.get("subtitle"),
        "sources": {"relay": db, "herdr": agents is not None},
        "kpi": read_git(root, cfg),
        "extras": read_extras(root, cfg),
        "summary": {
            "total": len(tree), "done": done, "counts": counts,
            "workers": len(workers), "working": sum(1 for w in workers if w["state"] == "working"),
        },
        "tasks": tree,
        "task_tree": tree,
        "counts": counts,
        "workers": workers,
        "attention": attention,
        "runtimes": runtimes,
    }


def _exec_label(cfg, w, pane, quiet_until, quiet_active, now_ms):
    """Herdr execution label; never conflated with Relay worker state."""
    if not cfg["herdr"].get("enabled", True) or os.environ.get("HERDR_ENV") != "1":
        return "unavailable"
    if pane and pane.get("agent_status") == "working":
        return "busy"
    if quiet_active:
        return f"quiet {fmt_age(int(quiet_until - now_ms))}"
    if w.get("state") == "working" and w.get("current_task_id") and pane is not None:
        return "!idle"  # working + runtime idle + no quiet => unexpected idle
    if pane is None:
        return "unavailable"
    return "idle"


# --------------------------------------------------------------------------- #
# render
# --------------------------------------------------------------------------- #
def fmt_age(ms):
    if ms is None:
        return "-"
    s = max(0, int(ms / 1000))
    if s < 60:
        return f"{s}s"
    m = s // 60
    if m < 60:
        return f"{m}m"
    return f"{m // 60}h"


def _dwidth(s):
    """Display width: East Asian Wide / Fullwidth count as 2."""
    w = 0
    for ch in s:
        if unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def _trim(s, w):
    """Trim to display width w (ellipsis on overflow). No ANSI in `s`."""
    s = s or ""
    if w <= 1:
        return ""
    if _dwidth(s) <= w:
        return s
    ell = _dwidth("…")
    out, used = "", 0
    for ch in s:
        cw = _dwidth(ch)
        if used + cw > w - ell:
            break
        out += ch
        used += cw
    return out + "…"


def _wrap_join(tokens, width):
    """Pack whitespace-separated tokens into lines of at most `width`."""
    out, cur = [], ""
    for tok in tokens:
        cand = tok if not cur else cur + " " + tok
        if cur and _dwidth(cand) > width:
            out.append(cur)
            cur = tok
        else:
            cur = cand
    if cur:
        out.append(cur)
    return out


def _term_width(default=120):
    try:
        return os.get_terminal_size(sys.stdout.fileno()).columns or default
    except Exception:
        try:
            return int(os.environ.get("COLUMNS") or default)
        except ValueError:
            return default


def _task_children(tree):
    by_id = {str(it["id"]): it for it in tree if it.get("id") is not None}
    children, roots = {}, []
    for it in tree:
        pid = it.get("parent")
        own = str(it.get("id"))
        if pid and str(pid) in by_id and str(pid) != own:
            children.setdefault(str(pid), []).append(it)
        else:
            roots.append(it)
    return children, roots


def _all_done(tree):
    """id -> True when the node and ALL its descendants are done."""
    children, _ = _task_children(tree)
    memo = {}

    def calc(it):
        iid = str(it["id"])
        if iid in memo:
            return memo[iid]
        kids = children.get(iid, [])
        res = (it["state"] == "done") and all(calc(k) for k in kids)
        memo[iid] = res
        return res

    for it in tree:
        calc(it)
    return memo, children


def _subtree_size(children, iid, seen=None):
    if seen is None:
        seen = set()
    n = 0
    for k in children.get(iid, []):
        kid = str(k["id"])
        if kid in seen:
            continue
        seen.add(kid)
        n += 1 + _subtree_size(children, kid, seen)
    return n


def _render_work(lines, tree, width, c):
    """Render the task tree with aligned id/state columns.

    Left columns are fixed (id, state) so ids and titles line up across depths;
    hierarchy is drawn with glyphs in the title column. Siblings show active
    first, then finished ones (folded when there are many).
    """
    if not tree:
        lines.append(c("  (none)", "gray"))
        return
    all_done, children = _all_done(tree)
    _, roots = _task_children(tree)
    st_w = 15 if width >= 64 else 8
    cols = 8 + 1 + st_w + 1  # id + sp + state + sp

    def emit_node(it, prefix, branch, child_prefix):
        iid = str(it["id"])
        kids = children.get(iid, [])
        st = it["state"]
        st_short = st[:st_w]
        tag = c(f"{st_short:<{st_w}}", TASK_COLOR.get(st))
        tree_txt = prefix + branch
        avail = width - cols - _dwidth(tree_txt)
        if kids and all_done.get(iid):
            total = 1 + _subtree_size(children, iid)
            suffix = f"  ({total}/{total} done)"
            title = "✓ " + _trim(it["title"], max(1, avail - _dwidth(suffix) - 2))
            lines.append(c(f"{str(it['id']):<8} {tag} {tree_txt}{title}{suffix}", "gray"))
            return
        owner = it.get("assignee") or it.get("role") or "-"
        role = f"  role={it['role']}" if (it.get("role") and it.get("assignee")) else ""
        tail = f"  [{owner}]" if owner else ""
        if avail - 8 < _dwidth(role):
            role = ""
        if avail - _dwidth(role) - 8 < _dwidth(tail):
            tail = ""
        title = _trim(it["title"], max(1, avail - _dwidth(role) - _dwidth(tail)))
        line = f"{str(it['id']):<8} {tag} {tree_txt}{title}{role}{tail}"
        lines.append(c(line, "dim") if st == "done" else line)
        if kids:
            emit_group(kids, child_prefix, False)

    def emit_group(nodes, prefix, top):
        active = [n for n in nodes if n["state"] != "done"]
        dones = sorted((n for n in nodes if n["state"] == "done"), key=lambda n: str(n["id"]))
        items = list(active)
        folded = None
        if len(dones) <= 3:
            items += dones
        else:
            # Many finished siblings: fold the whole group (subtree names are in
            # `render --json`; the text view favours the active branches).
            folded = sum(1 + _subtree_size(children, str(n["id"])) for n in dones)
            items.append(None)
        for i, n in enumerate(items):
            is_last = i == len(items) - 1
            branch = "" if top else ("└─ " if is_last else "├─ ")
            child_prefix = prefix + ("" if top else ("   " if is_last else "│  "))
            if n is None:
                lines.append(c(f"{'':<8} {c('✓', 'gray'):<{st_w}} {prefix}{branch}{folded} done", "gray"))
                continue
            emit_node(n, prefix, branch, child_prefix)

    emit_group(roots, "", True)


def render_text(data, use_color, links=False, width=120):
    c = lambda t, name: color(t, name, use_color)  # noqa: E731
    lines = []
    k = data["kpi"]
    head_left = f"relay / {data['title']}"
    head_right = f"{k['branch']} {k['head_sha']}"
    pad = width - _dwidth(head_left) - _dwidth(head_right)
    if pad >= 2:
        lines.append(c(_trim(head_left, width), "bold") + " " * pad + c(head_right, "gray"))
    else:
        lines.append(c(_trim(head_left, width), "bold"))
        lines.append(c(_trim(head_right, width), "gray"))
    if data.get("subtitle"):
        lines.append(c(_trim(data["subtitle"], width), "gray"))

    s = data["summary"]
    counts = data["counts"]
    parts = [f"{s['total']} tasks", f"{s['done']} done"]
    for st in TASK_ORDER:
        if counts.get(st, 0):
            parts.append(f"{counts[st]} {st}")
    lines.append(_trim("   ".join(parts), width))

    extra_parts = []
    for e in data.get("extras", []):
        v = str(e["value"])
        extra_parts.append(f"{e['label']} " + (color(v, "red", use_color) if v.startswith("!(") else v))
    if extra_parts:
        lines.append(_wrap_join(extra_parts, width)[0] if _dwidth("  ".join(extra_parts)) > width
                     else "  ".join(extra_parts))

    # ---- WORK ---------------------------------------------------------------
    lines.append("")
    lines.append(c("WORK", "bold"))
    _render_work(lines, data["tasks"], width, c)

    # ---- WORKERS ------------------------------------------------------------
    lines.append("")
    lines.append(c("WORKERS", "bold"))
    wk = data["workers"]
    if not wk:
        lines.append(c("  (none)", "gray"))
    for w in wk:
        state = color(f"{str(w['state']):<13}", WORKER_COLOR.get(w["state"]), use_color)
        exec_plain = w["exec"]
        exec_col = "green" if exec_plain == "busy" else ("red" if exec_plain == "!idle" else "cyan" if exec_plain.startswith("quiet") else "gray")
        exec_txt = color(f"{exec_plain:<12}", exec_col, use_color)
        task = str(w.get("task") or "-")
        tail = f'progress {fmt_age(w.get("progress_ms"))}'
        if w.get("quiet_active") and w.get("quiet_reason"):
            tail = f'"{_trim(w["quiet_reason"], 40)}"'
        lead = f"  {_trim(str(w['id']), 16):<16} {state} {exec_txt} {task:<5} "
        if _dwidth(lead) + 4 <= width:
            lines.append(lead + c(_trim(tail, max(1, width - _dwidth(lead))), "gray"))

    # ---- ATTENTION ----------------------------------------------------------
    lines.append("")
    lines.append(c("ATTENTION", "bold"))
    att = data["attention"]
    if not att:
        lines.append(c("  none", "gray"))
    for a in att:
        age = f"  {a['age']}" if a.get("age") else ""
        lines.append(c(f"  ! {str(a['id']):<16} {a['text']}{age}", "red"))

    # ---- RUNTIMES -----------------------------------------------------------
    runtimes = data["runtimes"]
    if runtimes and width >= 66:
        lines.append("")
        lines.append(c("RUNTIMES", "bold"))
        for r in runtimes:
            pane = r.get("pane")
            if pane:
                vis = f"{ANSI['underline']}{pane}{ANSI['reset']}" if links else pane
                pane_s = link(vis, f"{PANE_LINK_BASE}{pane}", links)
            else:
                pane_s = c("no-pane", "yellow")
            gen = f"g{r.get('generation')}"
            status = r.get("agent_status") or ("-" if not pane else "?")
            line = (f"  {_trim(str(r['worker']), 16):<16} {gen:<4} {pane_s:<9} "
                    f"{status}")
            lines.append(line)
        if links:
            lines.append(color("  Ctrl+click a pane id → focus that pane", "dim", use_color))

    # ---- sources footer -----------------------------------------------------
    lines.append("")
    src = ["relay:" + (Path(data["sources"]["relay"]).parent.parent.name
                       if data["sources"].get("relay") else "none"),
           "herdr:" + ("on" if data["sources"].get("herdr") else "off")]
    src_line = "sources " + "  ".join(src)
    if _dwidth(src_line) <= width:
        lines.append(c(src_line, "gray"))
    else:
        for i, chunk in enumerate(_wrap_join(["sources"] + src, width)):
            lines.append(c(("" if i == 0 else "  ") + chunk, "gray"))
    return "\n".join(lines)


def render_json(data):
    return json.dumps({
        "summary": data["summary"],
        "git": data["kpi"],
        "extras": data.get("extras", []),
        "tasks": data["task_tree"],
        "task_tree": data["task_tree"],
        "workers": data["workers"],
        "attention": data["attention"],
        "runtimes": data["runtimes"],
        "sources": data["sources"],
    }, ensure_ascii=False, indent=2)


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #
def _relay_error(root, cfg):
    """Return the RelayNotFound message for stderr, or None when Relay exists."""
    try:
        relay_db_or_fail(root, cfg)
        return None
    except RelayNotFound as exc:
        return exc.message()


def cmd_render(args, root, cfg):
    err = _relay_error(root, cfg)
    if err:
        print(err, file=sys.stderr)
        return 2
    data = collect(root, cfg, args.workspaces)
    if args.json:
        print(render_json(data))
    else:
        use_color = sys.stdout.isatty() or os.environ.get("FORCE_COLOR") == "1"
        links = use_color and bool(cfg["herdr"].get("links", True))
        print(render_text(data, use_color, links, _term_width()))
    return 0


def cmd_watch(args, root, cfg):
    explicit = getattr(args, "config", None)
    stamp = _config_stamp(root, explicit)
    try:
        while True:
            cur = _config_stamp(root, explicit)
            if cur != stamp:
                cfg, _ = load_config(root, explicit)
                stamp = cur
            interval = args.interval or cfg.get("watch_interval") or WATCH_DEFAULT
            err = _relay_error(root, cfg)
            sys.stdout.write("\033[2J\033[H")
            if err:
                print(err, file=sys.stderr)
            else:
                data = collect(root, cfg, args.workspaces)
                print(render_text(data, True, bool(cfg["herdr"].get("links", True)), _term_width()))
            sys.stdout.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    return 0


def _status_pane_file(root):
    return state_dir(root) / "status-pane"


def _pane_alive(pane):
    return herdr_json(["pane", "get", pane]) is not None


def cmd_show(args, root, cfg):
    if os.environ.get("HERDR_ENV") != "1":
        print("agent-status: not inside Herdr (HERDR_ENV != 1); run `status render` instead", file=sys.stderr)
        return 2
    target = args.pane or os.environ.get("HERDR_PANE_ID")
    sf = _status_pane_file(root)
    pane = None
    if sf.exists():
        old = sf.read_text().strip()
        if old and _pane_alive(old):
            pane = old
    if pane is None:
        if getattr(args, "as_tab", False):
            ws = (getattr(args, "tab_workspace", None) or os.environ.get("HERDR_WORKSPACE_ID")
                  or (target or "").split(":")[0] or None)
            argv = ["tab", "create"]
            if ws:
                argv += ["--workspace", ws]
            argv += ["--cwd", root,
                     "--label", getattr(args, "tab_label", None) or "agent-status", "--no-focus"]
            d = herdr_json(argv)
            try:
                pane = d["result"]["root_pane"]["pane_id"]
            except Exception:
                print("agent-status: tab create failed", file=sys.stderr)
                return 2
        else:
            d = herdr_json(["pane", "split", "--pane", target, "--direction", args.direction,
                            "--cwd", root, "--no-focus"]) if target else \
                herdr_json(["pane", "split", "--current", "--direction", args.direction,
                            "--cwd", root, "--no-focus"])
            try:
                pane = d["result"]["pane"]["pane_id"]
            except Exception:
                print("agent-status: pane split failed", file=sys.stderr)
                return 2
        sf.write_text(pane)
    script = str(Path(__file__).resolve())
    interval = args.interval or cfg.get("watch_interval") or WATCH_DEFAULT
    cmdline = f"python3 {shlex.quote(script)} watch --repo {shlex.quote(root)} --interval {interval}"
    if args.config:
        cmdline += f" --config {shlex.quote(args.config)}"
    run(["herdr", "pane", "run", pane, cmdline])
    where = "tab" if getattr(args, "as_tab", False) else f"direction={args.direction}"
    print(f"agent-status: live dashboard in {pane} ({where})")
    print(f"  stop with: python3 {shlex.quote(script)} hide --repo {shlex.quote(root)}")
    return 0


def cmd_hide(args, root):
    sf = _status_pane_file(root)
    if not sf.exists():
        print("agent-status: no tracked status pane")
        return 0
    pane = sf.read_text().strip()
    sf.unlink(missing_ok=True)
    if pane:
        if _pane_alive(pane):
            run(["herdr", "pane", "close", pane])
            print(f"agent-status: closed {pane}")
        else:
            print(f"agent-status: {pane} already gone")
    return 0


def cmd_doctor(args, root, cfg, cfg_path):
    db = find_relay_db(root, cfg)
    lines = [
        f"repo          {root}",
        f"config        {cfg_path or '(defaults)'}",
        f"HERDR_ENV     {os.environ.get('HERDR_ENV', '(unset)')}",
        f"relay db      {'OK ' + db if db else '(not found - run: relay init)'}",
    ]
    if not db:
        print("\n".join(lines))
        return 2
    relay = read_relay(db)
    if relay:
        lines.append(f"tasks         {len(relay['tasks'])}")
        lines.append(f"workers       {len(relay['workers'])}")
        lines.append(f"runtimes      {len(relay['runtimes'])}")
        placed = {r.get("worker_id") for r in relay["runtimes"] if r.get("pane_id")}
        ids = [w.get("id") for w in relay["workers"]]
        linked = sum(1 for i in ids if i in placed)
        lines.append(f"runtime links {linked}/{len(ids)}")
    sock = Path(db).parent / "relay.sock"
    lines.append(f"daemon/socket {'OK ' + str(sock) if sock.exists() else '(no socket)'}")
    agents = read_agents(cfg, root, args.workspaces)
    lines.append(f"herdr         {'OK (' + str(len(agents)) + ' panes)' if agents is not None else 'off'}")
    print("\n".join(lines))
    return 0


# --------------------------------------------------------------------------- #
# entrypoint
# --------------------------------------------------------------------------- #
def build_parser():
    ap = argparse.ArgumentParser(prog="status", description="read-only Relay dashboard (+ Herdr telemetry)")
    sub = ap.add_subparsers(dest="cmd")

    def common(p):
        p.add_argument("--repo", default=None, help="repo root (default: git toplevel or cwd)")
        p.add_argument("--config", default=None, help="config json path")
        p.add_argument("--workspace", action="append", default=[], dest="workspaces",
                       help="Herdr workspace id (repeatable)")

    p = sub.add_parser("render", help="print one snapshot (default)")
    common(p)
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("watch", help="clear + redraw in a loop")
    common(p)
    p.add_argument("--interval", type=float, default=None)

    p = sub.add_parser("show", help="open a live dashboard pane next to a Herdr pane")
    common(p)
    p.add_argument("--direction", choices=["right", "down"], default="right")
    p.add_argument("--pane", default=None)
    p.add_argument("--interval", type=float, default=None)
    p.add_argument("--tab", action="store_true", dest="as_tab",
                   help="open the dashboard in its own Herdr tab instead of splitting a pane")
    p.add_argument("--tab-label", default=None, help="label for the new tab (default: agent-status)")
    p.add_argument("--tab-workspace", default=None,
                   help="workspace id for the new tab (default: $HERDR_WORKSPACE_ID)")

    p = sub.add_parser("hide", help="close the tracked dashboard pane")
    p.add_argument("--repo", default=None)

    p = sub.add_parser("doctor", help="show which sources were detected")
    common(p)
    return ap


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0].startswith("-"):
        argv = ["render"] + argv
    args = build_parser().parse_args(argv)
    root = repo_root(getattr(args, "repo", None) or os.environ.get("AGENT_STATUS_REPO"))
    cfg, cfg_path = load_config(root, getattr(args, "config", None))

    if args.cmd == "render":
        return cmd_render(args, root, cfg)
    elif args.cmd == "watch":
        return cmd_watch(args, root, cfg)
    elif args.cmd == "show":
        return cmd_show(args, root, cfg)
    elif args.cmd == "hide":
        return cmd_hide(args, root)
    elif args.cmd == "doctor":
        return cmd_doctor(args, root, cfg, cfg_path)
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
