#!/usr/bin/env python3
"""agent-status - live progress dashboard over relay (relay/SQLite) + Herdr.

Sources, best-effort and independent:
  relay   : read-only view of <repo>/.relay/state.db (tasks / workers)
  herdr   : `herdr pane list` for the relevant workspaces (live agent state)
  git     : HEAD / branch / dirty count (KPI)
  plan    : optional hand-written .agent-status/plan.json fallback

Subcommands: render (default), watch, show, hide, doctor.
No third-party dependencies; Python 3.8+ stdlib only.
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import sqlite3
import subprocess
import sys
import time
import unicodedata
from pathlib import Path

STATE_DIRNAME = ".agent-status"
WATCH_DEFAULT = 5

DEFAULT_CONFIG = {
    "title": None,
    "subtitle": None,
    "relay": {"enabled": True, "db": None},
    "plan": {
        "enabled": True,
        "path": f"{STATE_DIRNAME}/plan.json",
        # Phase 2（スタール表示）で使う既定しきい値。
        "stall_after_minutes": 10,
    },
    "herdr": {"enabled": True, "workspaces": [], "cwd_match": True, "show_shells": False, "links": True},
    "kpi": {"exclude": ["README.md", "catalog.json", "notes/", "papers/", "summaries/", ".agent-status/"]},
    "extras": [],
    "watch_interval": WATCH_DEFAULT,
}

# ANSI palette
ANSI = {
    "reset": "\033[0m", "bold": "\033[1m", "dim": "\033[2m", "underline": "\033[4m",
    "red": "\033[31m", "green": "\033[32m", "yellow": "\033[33m",
    "blue": "\033[34m", "magenta": "\033[35m", "cyan": "\033[36m", "gray": "\033[90m",
}

TASK_ORDER = ["running", "queued", "review", "blocked_human", "blocked_internal", "failed"]
TASK_COLOR = {
    "running": "green", "queued": "cyan", "review": "yellow",
    "blocked_human": "red", "blocked_internal": "magenta", "failed": "red", "done": "gray",
}
# plan 台帳（done/working/delegated/pending/blocked）用
PLAN_COLOR = {
    "done": "green", "working": "yellow", "delegated": "cyan",
    "pending": "gray", "blocked": "red", "failed": "red",
    "running": "green", "queued": "cyan", "review": "yellow",
}
WORKER_COLOR = {
    "working": "green", "idle": "gray", "waiting_input": "yellow",
    "stalled": "red", "dead": "red", "starting": "cyan",
}
AGENT_COLOR = {
    "working": "green", "idle": "gray", "blocked": "red",
    "done": "gray", "unknown": "yellow",
}


# --------------------------------------------------------------------------- #
# small utilities
# --------------------------------------------------------------------------- #
def run(cmd, cwd=None, timeout=20):
    """Run a command. A list is exec'd directly; a string goes through the shell."""
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=timeout, shell=isinstance(cmd, str))
    except Exception:
        return None
    if p.returncode != 0:
        return None
    return p.stdout.strip()


def deep_merge(base, override):
    out = dict(base)
    for k, v in (override or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def repo_root(explicit):
    if explicit:
        return str(Path(explicit).expanduser().resolve())
    top = run(["git", "rev-parse", "--show-toplevel"])
    if top:
        return str(Path(top).resolve())
    return str(Path.cwd().resolve())


def state_dir(root):
    p = Path(root) / STATE_DIRNAME
    try:
        p.mkdir(parents=True, exist_ok=True)
        return p
    except Exception:
        import tempfile
        alt = Path(tempfile.gettempdir()) / f"agent-status-{abs(hash(root)) & 0xFFFFFF:x}"
        alt.mkdir(parents=True, exist_ok=True)
        return alt


def load_config(root, explicit):
    path = explicit or os.environ.get("AGENT_STATUS_CONFIG")
    p = None
    if path:
        p = Path(os.path.expanduser(path))
        if not p.is_absolute():
            p = Path(root) / p
    else:
        cand = Path(root) / STATE_DIRNAME / "config.json"
        p = cand if cand.exists() else None
    data = {}
    if p and p.exists():
        try:
            data = json.loads(p.read_text())
        except Exception as exc:  # noqa: BLE001
            print(f"agent-status: ignoring bad config {p}: {exc}", file=sys.stderr)
    return deep_merge(DEFAULT_CONFIG, data), (str(p) if p else None)


def _tracked_pane(root):
    """The pane this skill is currently drawing in, if any (no side effects)."""
    try:
        p = Path(root) / STATE_DIRNAME / "status-pane"
        if p.exists():
            return p.read_text().strip() or None
    except Exception:
        pass
    return None


def _config_stamp(root, explicit):
    path = explicit or os.environ.get("AGENT_STATUS_CONFIG")
    if path:
        p = Path(os.path.expanduser(path))
        if not p.is_absolute():
            p = Path(root) / p
    else:
        p = Path(root) / STATE_DIRNAME / "config.json"
    try:
        return (str(p), p.stat().st_mtime_ns)
    except Exception:
        return (str(p), None)


def is_under(path, root):
    if not path:
        return False
    try:
        return os.path.commonpath([os.path.realpath(path), os.path.realpath(root)]) == os.path.realpath(root)
    except Exception:
        return False


def color(text, name, enabled):
    if not enabled or not name:
        return text
    return f"{ANSI.get(name, '')}{text}{ANSI['reset']}"


OSC8_PREFIX = "\033]8;;"
OSC8_SUFFIX = "\033\\"
# Ctrl+click target for a pane. An https URL is recognized as a link by every
# terminal; Herdr's [[link_handlers]] then routes the modified click to the
# agent-status plugin instead of opening it. The host never resolves.
PANE_LINK_BASE = "https://agent-status.local/pane/"


def link(text, url, enabled):
    """Wrap text in an OSC8 hyperlink (ST-terminated). Inert when disabled."""
    if not enabled or not url:
        return text
    return f"{OSC8_PREFIX}{url}{OSC8_SUFFIX}{text}{OSC8_PREFIX}{OSC8_SUFFIX}"


def group_panes(panes):
    """Group panes as workspace -> tab -> panes, preserving encounter order.

    Returns `[(workspace_id, [tab_id, ...], {tab_id: [pane, ...]}), ...]`.
    """
    order, wmap = [], {}
    for p in panes:
        w = p.get("workspace_id") or "?"
        t = p.get("tab_id") or "?"
        if w not in wmap:
            wmap[w] = {"order": [], "tabs": {}}
            order.append(w)
        rec = wmap[w]
        if t not in rec["tabs"]:
            rec["tabs"][t] = []
            rec["order"].append(t)
        rec["tabs"][t].append(p)
    return [(w, wmap[w]["order"], wmap[w]["tabs"]) for w in order]


# --------------------------------------------------------------------------- #
# sources: relay
# --------------------------------------------------------------------------- #
def find_relay_db(root, cfg):
    cand = cfg["relay"].get("db") or os.environ.get("RELAY_DB")
    if cand:
        p = Path(os.path.expanduser(cand))
        if not p.is_absolute():
            p = Path(root) / p
        return str(p) if p.exists() else None
    cur = Path(root).resolve()
    for _ in range(12):
        p = cur / ".relay" / "state.db"
        if p.exists():
            return str(p)
        if cur.parent == cur:
            break
        cur = cur.parent
    return None


def _sqlite_rows(db, sql):
    """Read-only query. Try stdlib sqlite3, then the sqlite3 CLI as fallback."""
    try:
        uri = f"file:{db}?mode=ro"
        con = sqlite3.connect(uri, uri=True, timeout=3)
        con.row_factory = sqlite3.Row
        try:
            return [dict(r) for r in con.execute(sql).fetchall()]
        finally:
            con.close()
    except Exception:
        pass
    try:
        p = subprocess.run(["sqlite3", "-readonly", "-json", db, sql],
                           capture_output=True, text=True, timeout=10)
        if p.returncode == 0 and p.stdout.strip():
            return json.loads(p.stdout)
    except Exception:
        pass
    return None


def _has_column(db, table, column):
    """True when `table` exposes `column` (older relay DBs predate some of them)."""
    rows = _sqlite_rows(db, f"PRAGMA table_info({table})")
    return bool(rows) and any(r.get("name") == column for r in rows)


def read_relay(db):
    if not db:
        return None
    tasks = _sqlite_rows(
        db, "SELECT id,title,state,priority,role,assignee,parent_task_id,plan_id,updated_at FROM tasks")
    # Retired workers are history only (relay `worker retire`): their row survives
    # so old events stay resolvable, but they must never render as a live worker
    # (least of all as an "unplaced" one). Guard on the column so this keeps
    # working against a relay that predates the retirement feature.
    workers_sql = "SELECT id,role,state,current_task_id,generation,last_progress_at FROM workers"
    if _has_column(db, "workers", "retired_at"):
        workers_sql += " WHERE retired_at IS NULL"
    workers = _sqlite_rows(db, workers_sql)
    # Herdr placement per worker (used only for display grouping; absent on old DBs).
    runtimes = _sqlite_rows(
        db, "SELECT worker_id,generation,created_at,workspace_id,tab_id,pane_id,runtime_id FROM worker_runtimes")
    if tasks is None and workers is None:
        return None
    return {"db": db, "tasks": tasks or [], "workers": workers or [], "runtimes": runtimes or []}


# --------------------------------------------------------------------------- #
# sources: plan fallback
# --------------------------------------------------------------------------- #
def read_plan(root, cfg):
    if not cfg["plan"].get("enabled", True):
        return None, None
    raw = cfg["plan"].get("path") or f"{STATE_DIRNAME}/plan.json"
    p = Path(os.path.expanduser(raw))
    if not p.is_absolute():
        p = Path(root) / p
    if not p.exists():
        return None, None
    try:
        data = json.loads(p.read_text())
    except Exception as exc:  # noqa: BLE001
        print(f"agent-status: ignoring bad plan {p}: {exc}", file=sys.stderr)
        return str(p), None
    if isinstance(data, list):
        data = {"tasks": data}
    data.setdefault("tasks", [])
    return str(p), data


# --------------------------------------------------------------------------- #
# sources: herdr
# --------------------------------------------------------------------------- #
def herdr_json(args):
    out = run(["herdr"] + args)
    if not out:
        return None
    try:
        return json.loads(out)
    except Exception:
        return None


def relay_worker_workspaces(root, cfg):
    """relay の runtime が指している workspace（config に書き忘れた分を拾うため）。"""
    if not cfg["relay"].get("enabled", True):
        return []
    try:
        db = find_relay_db(root, cfg)
        if not db:
            return []
        rows = _sqlite_rows(
            db, "SELECT DISTINCT workspace_id FROM worker_runtimes WHERE workspace_id IS NOT NULL")
    except Exception:
        return []
    return [r.get("workspace_id") for r in rows if r.get("workspace_id")]


def read_agents(cfg, root, extra_ws):
    if not cfg["herdr"].get("enabled", True) or os.environ.get("HERDR_ENV") != "1":
        return None
    # Which workspaces to read:
    #   --workspace wins outright (an explicit scope, never widened);
    #   otherwise config.herdr.workspaces UNION every workspace relay has
    #   actually placed a worker in. The union is what stops a stale config
    #   entry from hiding workers that were moved to a new workspace — they
    #   would otherwise show up as bogus "unplaced workers (no pane)".
    if extra_ws:
        ws = list(dict.fromkeys(extra_ws))
    else:
        ws = list(dict.fromkeys(
            list(cfg["herdr"].get("workspaces") or []) + relay_worker_workspaces(root, cfg)))
        if not ws:
            cur = os.environ.get("HERDR_WORKSPACE_ID")
            if cur:
                ws = [cur]
    panes = []
    for w in ws:
        d = herdr_json(["pane", "list", "--workspace", w])
        if not d:
            continue
        tab_labels = {}
        td = herdr_json(["tab", "list", "--workspace", w])
        for t in (td or {}).get("result", {}).get("tabs", []):
            tab_labels[t.get("tab_id")] = t.get("label") or ""
        for p in d.get("result", {}).get("panes", []):
            panes.append({
                "pane_id": p.get("pane_id", "?"),
                "agent": p.get("agent") or "-",
                "agent_status": p.get("agent_status") or "unknown",
                "title": p.get("terminal_title_stripped") or p.get("terminal_title") or "",
                "cwd": p.get("cwd") or "",
                "workspace_id": p.get("workspace_id") or w,
                "tab_id": p.get("tab_id") or "",
                "tab_label": tab_labels.get(p.get("tab_id"), "") or "",
                "focused": bool(p.get("focused")),
            })
    if cfg["herdr"].get("cwd_match", True):
        panes = [p for p in panes if is_under(p["cwd"], root)]
    # Never list the dashboard's own pane.
    tracked = _tracked_pane(root)
    if tracked:
        panes = [p for p in panes if p["pane_id"] != tracked]
    # By default hide panes that are not running a recognized agent (shells,
    # one-off commands). Set herdr.show_shells=true to include them.
    if not cfg["herdr"].get("show_shells", False):
        panes = [p for p in panes if p["agent"] and p["agent"] != "-"]
    return panes


# --------------------------------------------------------------------------- #
# sources: git + extras
# --------------------------------------------------------------------------- #
def read_git(root, cfg):
    head = run(["git", "log", "-1", "--format=%h %s"], cwd=root) or "?"
    branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=root) or "?"
    raw = run(["git", "status", "--porcelain"], cwd=root) or ""
    exclude = cfg["kpi"].get("exclude") or []
    dirty = 0
    for line in raw.splitlines():
        path = line[3:] if len(line) > 3 else line
        if any(token in path for token in exclude):
            continue
        dirty += 1
    return {"head": head, "head_sha": head.split(" ")[0], "branch": branch, "dirty": dirty}


def run_extra(cmd, cwd):
    """Extras runner: never raises and always returns a display string.

    On failure returns `!(reason)` instead of a silent `?`. A list is exec'd
    directly; a string goes through the shell (pipes work).
    """
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=20, shell=isinstance(cmd, str))
    except subprocess.TimeoutExpired:
        return "!(timeout)"
    except FileNotFoundError as exc:
        return f"!(not found: {exc.filename or cmd})"
    except Exception as exc:  # noqa: BLE001
        return f"!({type(exc).__name__})"
    if p.returncode != 0:
        last = (p.stderr or "").strip().splitlines()
        return f"!(exit {p.returncode}{': ' + last[-1][:60] if last else ''})"
    return p.stdout.strip()


def read_extras(root, cfg):
    out = []
    for item in cfg.get("extras") or []:
        if not isinstance(item, dict) or not item.get("command"):
            continue
        raw = item["command"]
        label = item.get("label") or (raw if isinstance(raw, str) else " ".join(raw))
        out.append({"label": label, "value": run_extra(raw, root)})
    return out


# --------------------------------------------------------------------------- #
# collect
# --------------------------------------------------------------------------- #
def _tree_order(items, key=None):
    """Order a flat task list as a forest by `parent` (parent task id).

    Returns `[(item, depth), ...]`. Items are dicts with `id` and optional
    `parent`. Orphans and cycles fall back to depth 0 so nothing is ever dropped.
    `key` sorts siblings; `None` keeps input order.
    """
    by_id = {str(it["id"]): it for it in items if it.get("id") is not None}
    children, roots = {}, []
    for it in items:
        pid = it.get("parent")
        parent = str(pid) if pid not in (None, "", "null") else None
        own = str(it.get("id")) if it.get("id") is not None else None
        if parent and parent in by_id and parent != own:
            children.setdefault(parent, []).append(it)
        else:
            roots.append(it)
    if key:
        roots.sort(key=key)
        for group in children.values():
            group.sort(key=key)

    out, seen = [], set()

    def walk(node, depth):
        nid = str(node.get("id")) if node.get("id") is not None else None
        if nid is not None:
            if nid in seen:
                return
            seen.add(nid)
        out.append((node, depth))
        if nid is not None:
            for child in children.get(nid, []):
                walk(child, depth + 1)

    for root in roots:
        walk(root, 0)
    for it in items:  # cycles / unreachable
        nid = str(it.get("id")) if it.get("id") is not None else None
        if nid is not None and nid not in seen:
            seen.add(nid)
            out.append((it, 0))
    return out


# relay の task state -> plan 台帳の語彙（intent と突き合わせる observed 側の言い換え）。
RELAY_TO_PLAN = {
    "queued": "pending", "running": "working", "review": "review", "done": "done",
    "blocked_internal": "blocked", "blocked_human": "blocked", "failed": "failed",
}
# 1 項目に複数タスクが紐づくときの代表状態（先勝ち）。
RELAY_STATE_PRIORITY = ["blocked_human", "blocked_internal", "failed", "running", "review", "queued", "done"]
# 「進行中」とみなす宣言値（relay リンクが無いのにこの状態なら、表示は intent だけになる）。
IN_FLIGHT_STATUSES = {"working", "review", "delegated", "blocked"}
# 子から親へ畳むときの優先順（先勝ち）。
ROLLUP_PRIORITY = ["blocked", "working", "review", "failed", "pending", "done"]


def parts_by_plan(relay_tasks):
    """relay task を plan_id で束ねる（リンクは relay 側のデータ）。"""
    by_plan = {}
    for t in (relay_tasks or []):
        pid = t.get("plan_id")
        if pid:
            by_plan.setdefault(pid, []).append(t)
    return by_plan


def unknown_plan_links(plan_tasks, relay_tasks):
    """plan.json に存在しない plan_id を指している task（doctor 用）。"""
    ids = {it.get("id") for it in plan_tasks}
    return [(t.get("id"), t.get("plan_id")) for t in (relay_tasks or [])
            if t.get("plan_id") and t.get("plan_id") not in ids]


def derive_plan_state(plan_tasks, relay_tasks, cfg):
    """plan の intent は残したまま、relay の plan_id から observed を導出して親へ畳む。

    item に足すキー:
      declared  : plan.json に書かれた intent の status
      relay_ids : 紐づいた relay task の id（表示・`--json` 用）
      observed  : relay から見た状態（紐付けが無ければ None）
      effective : 表示に使う状態（observed → 子の rollup → declared の順）
      source    : effective の出どころ（"relay" / "rollup" / "intent"）
      drift     : effective と declared が食い違っているか

    リンクは `relay task add --plan <plan-id>` / `relay task link` が tasks.plan_id に
    保存した値だけで決まる（タイトルは見ない）。
    """
    by_plan = parts_by_plan(relay_tasks)

    children = {}
    for it in plan_tasks:
        children.setdefault(it.get("parent"), []).append(it)

    for it in plan_tasks:
        it["declared"] = it.get("status") or "pending"
        linked = by_plan.get(it.get("id")) or []
        it["relay_ids"] = [t.get("id") for t in linked]
        states = [t.get("state") or "queued" for t in linked]
        it["observed"] = RELAY_TO_PLAN.get(
            next((s for s in RELAY_STATE_PRIORITY if s in states), states[0]), states[0]) if states else None

    # 深い方から畳む（親が子の effective を参照できる順）。
    for it in sorted(plan_tasks, key=lambda x: -(x.get("depth") or 0)):
        if it.get("observed"):
            it["effective"], it["source"] = it["observed"], "relay"
        else:
            kids = children.get(it.get("id")) or []
            # rollup は relay 由来の子だけから畳む。観測が 1 つも無いなら
            # intent をそのまま出す（plan.json だけの repo を揺らさない）。
            states = [k.get("effective") or "pending" for k in kids if k.get("source") != "intent"]
            if states:
                it["effective"] = next((s for s in ROLLUP_PRIORITY if s in states), states[0])
                it["source"] = "rollup"
            else:
                it["effective"], it["source"] = it["declared"], "intent"
        it["drift"] = it["effective"] != it["declared"]
    return plan_tasks


def plan_view(plan, relay_tasks, cfg):
    items = [dict(it) for it in (plan.get("tasks") or [])]
    for it, depth in _tree_order(items):
        it["depth"] = depth
    return derive_plan_state(items, relay_tasks, cfg)


def collect(root, cfg, workspaces):
    relay = read_relay(find_relay_db(root, cfg))
    plan_path, plan = read_plan(root, cfg)
    agents = read_agents(cfg, root, workspaces)

    tasks = {"counts": {}, "total": 0, "done": 0, "remaining": [], "done_list": []}
    if relay:
        for t in relay["tasks"]:
            st = t.get("state") or "queued"
            tasks["counts"][st] = tasks["counts"].get(st, 0) + 1
        tasks["total"] = len(relay["tasks"])
        tasks["done"] = tasks["counts"].get("done", 0)
        order = {s: i for i, s in enumerate(TASK_ORDER)}
        items = [{
            "id": t.get("id"), "state": t.get("state") or "queued",
            "title": t.get("title") or "", "priority": t.get("priority"),
            "role": t.get("role"), "assignee": t.get("assignee"),
            "parent": t.get("parent_task_id"), "updated_at": t.get("updated_at"),
        } for t in relay["tasks"]]
        ranked = _tree_order(
            items, key=lambda x: (order.get(x["state"], 99), -(x["priority"] or 0)))
        for item, depth in ranked:
            item["depth"] = depth
            (tasks["done_list"] if item["state"] == "done" else tasks["remaining"]).append(item)

    workers = []
    if relay:
        now_ms = time.time() * 1000
        # Latest runtime row per worker (highest generation, then newest created_at).
        latest = {}
        for r in relay.get("runtimes") or []:
            wid = r.get("worker_id")
            if not wid:
                continue
            key = (r.get("generation") or 0, r.get("created_at") or 0)
            if wid not in latest or key > latest[wid][0]:
                latest[wid] = (key, r)
        for w in relay["workers"]:
            lp = w.get("last_progress_at") or 0
            rt = latest.get(w.get("id"), (None, {}))[1]
            workers.append({
                "id": w.get("id"), "role": w.get("role"), "state": w.get("state"),
                "task": w.get("current_task_id"), "generation": w.get("generation"),
                "idle_ms": int(now_ms - lp) if lp else None,
                "workspace": rt.get("workspace_id"), "tab": rt.get("tab_id"),
                "pane": rt.get("pane_id"),
            })
        # Group order = workspace, then worker id (regex-free; "~" sorts absent last).
        workers.sort(key=lambda x: (x.get("workspace") or "~", x["id"] or ""))

    plan_tasks = []
    if plan:
        plan_tasks = plan_view(plan, (relay or {}).get("tasks") or [], cfg)

    title = cfg.get("title") or Path(root).name
    return {
        "root": root,
        "title": title,
        "subtitle": cfg.get("subtitle"),
        "sources": {
            "relay": (relay or {}).get("db"),
            "plan": plan_path if plan else None,
            "herdr": agents is not None,
        },
        "kpi": read_git(root, cfg),
        "extras": read_extras(root, cfg),
        "tasks": tasks,
        "workers": workers,
        "workers_by_pane": {w["pane"]: w for w in workers if w.get("pane")},
        "plan": plan_tasks,
        "plan_title": (plan or {}).get("title") if plan else None,
        "agents": agents or [],
    }


# --------------------------------------------------------------------------- #
# render
# --------------------------------------------------------------------------- #
def fmt_age(ms):
    if ms is None:
        return "-"
    s = max(0, int(ms / 1000))
    if s < 60:
        return f"{s}s"
    m = s // 60
    if m < 60:
        return f"{m}m"
    return f"{m // 60}h"


def progress_bar(done, total, width=22):
    if total <= 0:
        return "[" + "-" * width + "]"
    filled = int(round(width * done / total))
    return "[" + "#" * filled + "-" * (width - filled) + "]"


def _dwidth(s):
    """端末上の表示幅。East Asian Wide / Fullwidth は 2 桁として数える。"""
    w = 0
    for ch in s:
        if unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def _trim(s, w):
    """表示幅 w に収まるよう切り詰める（溢れる分は … に置換）。ANSI を含まない文字列に使う。"""
    s = s or ""
    if w <= 1:
        return ""
    if _dwidth(s) <= w:
        return s
    ell = _dwidth("…")
    out, used = "", 0
    for ch in s:
        cw = _dwidth(ch)
        if used + cw > w - ell:
            break
        out += ch
        used += cw
    return out + "…"


def _wrap_join(tokens, width):
    """トークン列を空白区切りで width 桁に詰める（1 行が長い場合の折り返し回避）。"""
    out, cur = [], ""
    for tok in tokens:
        cand = tok if not cur else cur + " " + tok
        if cur and _dwidth(cand) > width:
            out.append(cur)
            cur = tok
        else:
            cur = cand
    if cur:
        out.append(cur)
    return out


def _fit_tail(base, tail, width, reserve=6):
    """tail を付けると本文が reserve 桁未満になるなら tail を落とす（折り返し防止）。"""
    return tail if base + _dwidth(tail) + reserve <= width else ""


def _term_width(default=120):
    """描画先の桁数。pane 内 (watch) では resize にも追従する。"""
    try:
        return os.get_terminal_size(sys.stdout.fileno()).columns or default
    except Exception:
        try:
            return int(os.environ.get("COLUMNS") or default)
        except ValueError:
            return default


def render_text(data, use_color, links=False, width=120):
    c = lambda t, name: color(t, name, use_color)  # noqa: E731
    lines = []
    lines.append(c(_trim(data["title"], width), "bold"))
    if data.get("subtitle"):
        lines.append(c(_trim(data["subtitle"], width), "gray"))
    k = data["kpi"]
    lines.append(_trim(f"HEAD {k['head_sha']}  branch {k['branch']}  dirty {k['dirty']}", width))
    extra_parts, extra_plain = [], []
    for e in data.get("extras", []):
        v = str(e["value"])
        extra_parts.append(f"{e['label']} " + (color(v, "red", use_color) if v.startswith("!(") else v))
        extra_plain.append(f"{e['label']} {v}")
    extra = "  ".join(extra_parts)
    if extra:
        if _dwidth("  ".join(extra_plain)) <= width:
            lines.append(extra)
        else:
            for chunk in _wrap_join(extra_plain, width):
                lines.append(chunk)

    t = data["tasks"]
    if t["total"] or data.get("sources", {}).get("relay"):
        counts = t["counts"]
        workers = data["workers"]
        working = sum(1 for w in workers if w["state"] == "working")
        counts_list = ["running", "queued", "review", "blocked_human", "blocked_internal", "failed"]
        counts_txt = " ".join(f"{s}={counts.get(s, 0)}" for s in counts_list)
        fixed_w = (len(f"tasks {t['done']}/{t['total']} ") + 3
                   + len(f"workers {working} working / {len(workers)}"))
        bar_w = min(22, max(6, width - fixed_w - 2))
        if fixed_w + 8 <= width:
            bar = progress_bar(t["done"], t["total"], bar_w)
            counts_head = (f"tasks {c(str(t['done']), 'green')}/{t['total']} {bar}   "
                           f"workers {c(str(working), 'green')} working / {len(workers)}")
            counts_head_w = fixed_w + len(bar)
        else:
            # バーを出す余白がない極端に狭い pane では数値だけに畳む。
            bar = ""
            counts_head = (f"tasks {c(str(t['done']), 'green')}/{t['total']}  "
                           f"workers {c(str(working), 'green')}/{len(workers)}")
            counts_head_w = len(f"tasks {t['done']}/{t['total']}  workers {working}/{len(workers)}")
        lines.append("")
        if counts_head_w + 3 + len(counts_txt) <= width:
            lines.append(counts_head + "   " + counts_txt)
        else:
            # 折り返すくらいなら 2 行以上に分ける（読み順を保つ）。
            lines.append(counts_head)
            for chunk in _wrap_join([f"{s}={counts.get(s, 0)}" for s in counts_list], width):
                lines.append(c(chunk, "gray"))

        lines.append("")
        lines.append(c("REMAINING", "bold"))
        if not t["remaining"]:
            lines.append(c("  (none)", "gray"))
        for it in t["remaining"]:
            st = it["state"]
            owner = it.get("assignee") or it.get("role") or "-"
            indent = "  " * (it.get("depth") or 0)
            # 狭い pane では owner → state の順に畳む（まず本文の余地を確保する）。
            tag_w = 16
            if width < 44:
                tag_w, st, owner = 8, st[:8], None
            tail = _fit_tail(2 + len(indent) + tag_w + 1 + 8 + 1,
                             f"  [{owner}]" if owner else "", width)
            tag = color(f"{st:<{tag_w}}", TASK_COLOR.get(it["state"]), use_color)
            used = 2 + len(indent) + tag_w + 1 + 8 + 1 + _dwidth(tail)
            lines.append(f"  {indent}{tag} {it.get('id') or '?':<8} "
                         f"{_trim(it['title'], width - used)}{tail}")

        lines.append("")
        lines.append(c(f"DONE ({t['done']})", "bold"))
        if not t["done_list"]:
            lines.append(c("  (none)", "gray"))
        for it in t["done_list"][:30]:
            indent = "  " * (it.get("depth") or 0)
            used = 2 + len(indent) + 8 + 1
            lines.append(c(f"  {indent}{str(it.get('id') or '?'):<8} "
                           f"{_trim(it['title'], width - used)}", "gray"))
        if len(t["done_list"]) > 30:
            lines.append(c(f"  ... +{len(t['done_list']) - 30} more", "gray"))

    if data["plan"]:
        lines.append("")
        lines.append(c(_trim("PLAN (" + (data.get("plan_title") or "manual") + ")", width), "bold"))
        for it in data["plan"]:
            st = it.get("effective") or it.get("declared") or "pending"
            tag = color(f"{st:<10}", PLAN_COLOR.get(st, "gray"), use_color)
            indent = "  " * (it.get("depth") or 0)
            tail = _fit_tail(2 + len(indent) + 10 + 1,
                             f"  [{it.get('owner') or '-'}]" + (f"  - {it['note']}" if it.get("note") else ""),
                             width)
            fixed = 2 + len(indent) + 10 + 1 + _dwidth(tail)
            # intent と observed が食い違う行だけ、末尾に宣言値を併記する。
            mark = ""
            if it.get("drift"):
                ids = ",".join(it.get("relay_ids") or [])
                candidate = f"  ←{it.get('declared')}" + (f" ({ids})" if ids else "")
                # 併記のために本文が削られすぎるなら落とす（注記だけの行にしない）。
                if fixed + _dwidth(candidate) + 6 <= width:
                    mark = candidate
            lines.append(f"  {indent}{tag} "
                         f"{_trim(it.get('title') or '?', width - fixed - _dwidth(mark))}"
                         f"{tail}{c(mark, 'yellow') if mark else ''}")

    workers = data.get("workers") or []
    by_pane = data.get("workers_by_pane") or {}

    def worker_cells(w, width):
        """relay 列: worker id / 現在タスク / 最終進捗。狭い pane では列を段階的に落とす。

        戻り値は (表示文字列, 可視幅)。
        """
        full = 16 + 1 + 4 + 1 + 4
        if width >= 86:
            if not w:
                return c(f"{'-':<16} {'-':<4} {'-':>4}", "gray"), full
            return (f"{str(w.get('id') or '-')[:16]:<16} {str(w.get('task') or '-'):<4} "
                    f"{fmt_age(w.get('idle_ms')):>4}"), full
        if width >= 66:
            if not w:
                return c(f"{'-':<16}", "gray"), 16
            return f"{str(w.get('id') or '-')[:16]:<16}", 16
        return "", 0

    def agent_line(base, a):
        tag = color(f"{a['agent_status']:<8}", AGENT_COLOR.get(a["agent_status"]), use_color)
        star = "*" if a.get("focused") else " "
        plain = a["pane_id"] or "?"
        pidw = 9 if width >= 36 else 7  # 極端に狭いときは pane 列のパディングを削る
        vis = f"{ANSI['underline']}{plain}{ANSI['reset']}" if links else plain
        pid = link(vis, f"{PANE_LINK_BASE}{plain}", links)
        pad = " " * max(0, pidw - len(plain))
        cells, cells_w = worker_cells(by_pane.get(plain), width)
        used = len(base) + 1 + pidw + 1 + 8 + (1 + cells_w if cells_w else 0) + 2
        head = f"{base}{star}{pid}{pad} {tag}" + (f" {cells}" if cells_w else "") + "  "
        return head + _trim(a["title"], width - used)

    def worker_lines(ws, ws_workers, indent):
        ind_w = _dwidth(indent)
        # 固定部: indent + state(14) + ' ' + ' task='(6)
        lead = ind_w + 14 + 1 + 6
        for w in ws_workers:
            tag = color(f"{w['state']:<14}", WORKER_COLOR.get(w["state"]), use_color)
            tail = f"gen={w.get('generation')}  last-progress {fmt_age(w.get('idle_ms'))}"
            tail_w = _dwidth(tail)
            # 右端の tail は、id(最低4) + task(最低1) の余地が残るときだけ付ける。
            tail_part = 2 + tail_w
            keep_tail = lead + tail_part + 4 + 1 <= width
            avail = width - lead - (tail_part if keep_tail else 0)
            id_w = max(4, min(16, avail - 1))
            id_s = _trim(str(w["id"]), id_w)
            task_s = _trim(w.get("task") or "-", max(1, avail - _dwidth(id_s)))
            line = f"{indent}{tag} {id_s} task={task_s}"
            if keep_tail:
                line += "  " + tail
            lines.append(line)

    if data["agents"]:
        lines.append("")
        lines.append(c("AGENTS", "bold"))
        groups = group_panes(data["agents"])
        multi_ws = len(groups) > 1
        for w, tab_order, tabs in groups:
            if multi_ws:
                lines.append(" " + c(w, "blue"))
            for t in tab_order:
                panes = tabs[t]
                tab_label = panes[0].get("tab_label") or ""
                if len(panes) == 1:
                    # 1 pane しかない tab は見出しもラベルも出さず、pane 行だけを 1 行で出す。
                    base = " " + ("  " if multi_ws else "")
                    lines.append(agent_line(base, panes[0]))
                else:
                    head = t + (f"  {tab_label}" if tab_label else "")
                    head = _trim(head, width - 1 - (2 if multi_ws else 0))
                    lines.append(" " + ("  " if multi_ws else "") + c(head, "blue"))
                    base = " " + "  " * ((1 if multi_ws else 0) + 1)
                    for a in panes:
                        lines.append(agent_line(base, a))

        # pane を持たない worker（未 spawn / cleanup 済み / cwd 不一致で pane が隠れている等）。
        placed = {by_pane[a["pane_id"]].get("id") for a in data["agents"] if a.get("pane_id") in by_pane}
        unplaced = [w for w in workers if w.get("id") not in placed]
        if unplaced:
            lines.append("")
            lines.append(c("  UNPLACED WORKERS (no pane)", "bold"))
            worker_lines(None, unplaced, "  ")
        if links:
            lines.append(color("  Ctrl+click a pane id → focus that pane", "dim", use_color))
    elif workers:
        # Herdr 未使用時は relay だけで描く（worker の居場所でまとめる）。
        lines.append("")
        lines.append(c("RELAY WORKERS", "bold"))
        groups = {}
        for w in workers:
            groups.setdefault(w.get("workspace"), []).append(w)
        multi_ws = len(groups) > 1
        for ws, ws_workers in groups.items():
            if multi_ws:
                lines.append(" " + c(ws or "-", "blue"))
            worker_lines(ws, ws_workers, "    " if multi_ws else "  ")

    lines.append("")
    src = []
    src.append("relay:" + (Path(data["sources"]["relay"]).parent.parent.name
                           if data["sources"].get("relay") else "none"))
    src.append("herdr:" + ("on" if data["sources"].get("herdr") else "off"))
    src.append("plan:" + ("yes" if data["sources"].get("plan") else "no"))
    src_line = "sources " + "  ".join(src)
    if _dwidth(src_line) <= width:
        lines.append(c(src_line, "gray"))
    else:
        for i, chunk in enumerate(_wrap_join(["sources"] + src, width)):
            lines.append(c(("" if i == 0 else "  ") + chunk, "gray"))
    return "\n".join(lines)


def render_json(data):
    return json.dumps(data, ensure_ascii=False, indent=2)


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #
def cmd_render(args, root, cfg):
    data = collect(root, cfg, args.workspaces)
    if args.json:
        print(render_json(data))
    else:
        use_color = sys.stdout.isatty() or os.environ.get("FORCE_COLOR") == "1"
        links = use_color and bool(cfg["herdr"].get("links", True))
        print(render_text(data, use_color, links, _term_width()))


def cmd_watch(args, root, cfg):
    explicit = getattr(args, "config", None)
    stamp = _config_stamp(root, explicit)
    try:
        while True:
            cur = _config_stamp(root, explicit)
            if cur != stamp:  # config.json edited/appeared/removed -> reload
                cfg, _ = load_config(root, explicit)
                stamp = cur
            interval = args.interval or cfg.get("watch_interval") or WATCH_DEFAULT
            data = collect(root, cfg, args.workspaces)
            sys.stdout.write("\033[2J\033[H")
            print(render_text(data, True, bool(cfg["herdr"].get("links", True)), _term_width()))
            sys.stdout.flush()
            time.sleep(interval)
    except KeyboardInterrupt:
        pass


def _status_pane_file(root):
    return state_dir(root) / "status-pane"


def _pane_alive(pane):
    return herdr_json(["pane", "get", pane]) is not None


def cmd_show(args, root, cfg):
    if os.environ.get("HERDR_ENV") != "1":
        print("agent-status: not inside Herdr (HERDR_ENV != 1); run `status render` instead", file=sys.stderr)
        return 2
    target = args.pane or os.environ.get("HERDR_PANE_ID")
    sf = _status_pane_file(root)
    pane = None
    if sf.exists():
        old = sf.read_text().strip()
        if old and _pane_alive(old):
            pane = old
    if pane is None:
        if getattr(args, "as_tab", False):
            # 独立タブ: 他の pane を分割せず、専用タブの root pane で動かす。
            ws = (getattr(args, "tab_workspace", None) or os.environ.get("HERDR_WORKSPACE_ID")
                  or (target or "").split(":")[0] or None)
            argv = ["tab", "create"]
            if ws:
                argv += ["--workspace", ws]
            argv += ["--cwd", root,
                     "--label", getattr(args, "tab_label", None) or "agent-status", "--no-focus"]
            d = herdr_json(argv)
            try:
                pane = d["result"]["root_pane"]["pane_id"]
            except Exception:
                print("agent-status: tab create failed", file=sys.stderr)
                return 2
        else:
            d = herdr_json(["pane", "split", "--pane", target, "--direction", args.direction,
                            "--cwd", root, "--no-focus"]) if target else \
                herdr_json(["pane", "split", "--current", "--direction", args.direction,
                            "--cwd", root, "--no-focus"])
            try:
                pane = d["result"]["pane"]["pane_id"]
            except Exception:
                print("agent-status: pane split failed", file=sys.stderr)
                return 2
        sf.write_text(pane)
    script = str(Path(__file__).resolve())
    interval = args.interval or cfg.get("watch_interval") or WATCH_DEFAULT
    cmdline = f"python3 {shlex.quote(script)} watch --repo {shlex.quote(root)} --interval {interval}"
    if args.config:
        cmdline += f" --config {shlex.quote(args.config)}"
    run(["herdr", "pane", "run", pane, cmdline])
    where = "tab" if getattr(args, "as_tab", False) else f"direction={args.direction}"
    print(f"agent-status: live dashboard in {pane} ({where})")
    print(f"  stop with: python3 {shlex.quote(script)} hide --repo {shlex.quote(root)}")
    return 0


def cmd_hide(args, root):
    sf = _status_pane_file(root)
    if not sf.exists():
        print("agent-status: no tracked status pane")
        return 0
    pane = sf.read_text().strip()
    sf.unlink(missing_ok=True)
    if pane:
        if _pane_alive(pane):
            run(["herdr", "pane", "close", pane])
            print(f"agent-status: closed {pane}")
        else:
            print(f"agent-status: {pane} already gone")
    return 0


def cmd_doctor(args, root, cfg, cfg_path):
    db = find_relay_db(root, cfg)
    plan_path, plan = read_plan(root, cfg)
    relay = read_relay(db) if db else None
    lines = [
        f"repo            {root}",
        f"config          {cfg_path or '(defaults)'}",
        f"HERDR_ENV       {os.environ.get('HERDR_ENV', '(unset)')}",
        f"HERDR_WORKSPACE {os.environ.get('HERDR_WORKSPACE_ID', '(unset)')}",
        f"relay db        {db or '(not found)'}",
    ]
    if relay:
        lines.append(f"  tasks         {len(relay['tasks'])} rows")
        lines.append(f"  workers       {len(relay['workers'])} rows")
    lines.append(f"plan            {plan_path or '(not found)'}"
                 + (f"  tasks={len(plan.get('tasks', []))}" if plan else ""))
    if plan:
        derived = plan_view(plan, (relay or {}).get("tasks") or [], cfg)
        linked = sum(1 for it in derived if it.get("relay_ids"))
        drift = [it.get("id") for it in derived if it.get("drift")]
        unknown = unknown_plan_links(derived, (relay or {}).get("tasks") or [])
        lines.append(f"  links         {linked}/{len(derived)} items <- relay tasks"
                     + (f"  drift={','.join(str(d) for d in drift)}" if drift else "  drift=none"))
        # 進行中と宣言しているのに relay と繋がっていない項目 = 状態が intent のままで古びる行。
        # （rollup で観測が伝播している親は「紐付き無し」ではないので除く。）
        unlinked = [it.get("id") for it in derived
                    if it.get("source") == "intent" and not it.get("relay_ids")
                    and it.get("declared") in IN_FLIGHT_STATUSES]
        if unlinked:
            lines.append("  unlinked      " + ",".join(str(i) for i in unlinked)
                         + "  (in-flight but no relay task; shown from intent only)")
        if unknown:
            lines.append("  unknown links "
                         + ", ".join(f"{tid}->{pid}" for tid, pid in unknown)
                         + "  (no such plan item)")
    agents = read_agents(cfg, root, args.workspaces)
    lines.append(f"herdr panes     {len(agents) if agents is not None else 'off'}")
    print("\n".join(lines))
    return 0


# --------------------------------------------------------------------------- #
# entrypoint
# --------------------------------------------------------------------------- #
def build_parser():
    ap = argparse.ArgumentParser(prog="status", description="live progress dashboard (relay + Herdr)")
    sub = ap.add_subparsers(dest="cmd")

    def common(p):
        p.add_argument("--repo", default=None, help="repo root (default: git toplevel or cwd)")
        p.add_argument("--config", default=None, help="config json path")
        p.add_argument("--workspace", action="append", default=[], dest="workspaces",
                       help="Herdr workspace id (repeatable)")

    p = sub.add_parser("render", help="print one snapshot (default)")
    common(p)
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("watch", help="clear + redraw in a loop")
    common(p)
    p.add_argument("--interval", type=float, default=None)

    p = sub.add_parser("show", help="open a live dashboard pane next to a Herdr pane")
    common(p)
    p.add_argument("--direction", choices=["right", "down"], default="right")
    p.add_argument("--pane", default=None)
    p.add_argument("--interval", type=float, default=None)
    p.add_argument("--tab", action="store_true", dest="as_tab",
                   help="open the dashboard in its own Herdr tab instead of splitting a pane")
    p.add_argument("--tab-label", default=None, help="label for the new tab (default: agent-status)")
    p.add_argument("--tab-workspace", default=None,
                   help="workspace id for the new tab (default: $HERDR_WORKSPACE_ID)")

    p = sub.add_parser("hide", help="close the tracked dashboard pane")
    p.add_argument("--repo", default=None)

    p = sub.add_parser("doctor", help="show which sources were detected")
    common(p)
    return ap


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0].startswith("-"):
        argv = ["render"] + argv
    args = build_parser().parse_args(argv)
    root = repo_root(getattr(args, "repo", None) or os.environ.get("AGENT_STATUS_REPO"))
    cfg, cfg_path = load_config(root, getattr(args, "config", None))

    if args.cmd == "render":
        cmd_render(args, root, cfg)
    elif args.cmd == "watch":
        cmd_watch(args, root, cfg)
    elif args.cmd == "show":
        return cmd_show(args, root, cfg)
    elif args.cmd == "hide":
        return cmd_hide(args, root)
    elif args.cmd == "doctor":
        return cmd_doctor(args, root, cfg, cfg_path)
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
